#usda 1.0
(
    defaultPrim = "Root"
    doc = """The hardware showcase room for the visionOS immersive space. Our own asset, written by hand.

    Units are meters, Y is up. The origin is on the floor where the viewer sits, facing -Z.
    A bright store-style room with Meshtastic green walls: five narrow maple display tables stepping up toward the back wall; the back wall at z = -2.6
    with the wall rack hung on it above the back table; and the Meshtastic mark on the left wall. The side behind the viewer is open.

    Shapes are unit cubes scaled to size. Lights are added in code. The Anchor_* prims are empty and are read by name in ShowcaseRoom.load(). Their local +Z
    points toward the viewer, and +Y is up. Keep
    ShowcaseRoomGeometry.swift in step when one moves."""
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    # ------------------------------------------------------------------------------------------
    # Materials: plain physically based colors and glowing ceiling strips.
    # ------------------------------------------------------------------------------------------
    def Scope "Materials"
    {
        def Material "Floor"
        {
            # Pale stone, lightly polished.
            token outputs:surface.connect = </Root/Materials/Floor/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.78, 0.74)
                float inputs:roughness = 0.35
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "Wall"
        {
            # Meshtastic green, Green 500 (#67EA94), in linear color.
            token outputs:surface.connect = </Root/Materials/Wall/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.136, 0.823, 0.296)
                float inputs:roughness = 0.85
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "Ceiling"
        {
            token outputs:surface.connect = </Root/Materials/Ceiling/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.96, 0.95)
                float inputs:roughness = 0.9
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "Maple"
        {
            # Light maple for the display tables.
            token outputs:surface.connect = </Root/Materials/Maple/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.84, 0.7, 0.52)
                float inputs:roughness = 0.45
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "LightStrip"
        {
            # Ceiling light panels.
            token outputs:surface.connect = </Root/Materials/LightStrip/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:emissiveColor = (0.55, 0.54, 0.52)
                float inputs:roughness = 1
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "RackPanel"
        {
            token outputs:surface.connect = </Root/Materials/RackPanel/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.08, 0.07)
                float inputs:roughness = 0.45
                float inputs:metallic = 0.6
                token outputs:surface
            }
        }
        def Material "Logo"
        {
            # Dark charcoal (#3D3E50), the app's primary text color, in linear color.
            token outputs:surface.connect = </Root/Materials/Logo/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.047, 0.048, 0.08)
                float inputs:roughness = 0.5
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
    }

    # ------------------------------------------------------------------------------------------
    # Room shell. Walls are 6 cm thick, set outside the inner faces.
    # ------------------------------------------------------------------------------------------
    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Floor>
        float3 xformOp:translate = (0, -0.02, -0.8)
        float3 xformOp:scale = (3.52, 0.04, 3.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Ceiling>
        float3 xformOp:translate = (0, 2.82, -0.8)
        float3 xformOp:scale = (3.52, 0.04, 3.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "BackWall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Wall>
        float3 xformOp:translate = (0, 1.4, -2.63)
        float3 xformOp:scale = (3.52, 2.8, 0.06)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "RightWall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Wall>
        float3 xformOp:translate = (1.73, 1.4, -0.8)
        float3 xformOp:scale = (0.06, 2.8, 3.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "LeftWall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Wall>
        float3 xformOp:translate = (-1.73, 1.4, -0.8)
        float3 xformOp:scale = (0.06, 2.8, 3.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    # The Meshtastic mark, from the app's logo, raised 3 cm off the left wall.
    def Mesh "Logo" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/Materials/Logo>
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3