#usda 1.0
(
    defaultPrim = "Root"
    doc = """The hardware showcase room for the visionOS immersive space. Our own asset, written by hand.

    Units are meters, Y is up. The origin is on the floor where the viewer sits, facing -Z.
    A bright store-style room with Meshtastic green walls: two maple display tables in front of the viewer, the nearer one
    with a low riser along its back, the wall rack on the right wall (x = +1.7), and the back
    wall at z = -2.6. The side behind the viewer is open.

    Shapes are unit cubes scaled to size. Lights are added in code. The Anchor_* prims are empty and are read by name in ShowcaseRoom.load(). Their local +Z
    points toward the viewer (out of the wall for the rack), and +Y is up. Keep
    ShowcaseRoomGeometry.swift in step when one moves."""
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    # ------------------------------------------------------------------------------------------
    # Materials: plain physically based colors and glowing ceiling strips.
    # ------------------------------------------------------------------------------------------
    def Scope "Materials"
    {
        def Material "Floor"
        {
            # Pale stone, lightly polished.
            token outputs:surface.connect = </Root/Materials/Floor/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.78, 0.74)
                float inputs:roughness = 0.35
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "Wall"
        {
            # Meshtastic green, Green 500 (#67EA94), in linear color.
            token outputs:surface.connect = </Root/Materials/Wall/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.136, 0.823, 0.296)
                float inputs:roughness = 0.85
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "Ceiling"
        {
            token outputs:surface.connect = </Root/Materials/Ceiling/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.96, 0.95)
                float inputs:roughness = 0.9
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "Maple"
        {
            # Light maple for the display tables.
            token outputs:surface.connect = </Root/Materials/Maple/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.84, 0.7, 0.52)
                float inputs:roughness = 0.45
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "Riser"
        {
            # White riser on the front table.
            token outputs:surface.connect = </Root/Materials/Riser/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.97, 0.97, 0.96)
                float inputs:roughness = 0.6
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "LightStrip"
        {
            # Ceiling light panels.
            token outputs:surface.connect = </Root/Materials/LightStrip/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:emissiveColor = (1, 0.98, 0.94)
                float inputs:roughness = 1
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }
        def Material "RackPanel"
        {
            token outputs:surface.connect = </Root/Materials/RackPanel/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.08, 0.07)
                float inputs:roughness = 0.45
                float inputs:metallic = 0.6
                token outputs:surface
            }
        }
    }

    # ------------------------------------------------------------------------------------------
    # Room shell. Walls are 6 cm thick, set outside the inner faces.
    # ------------------------------------------------------------------------------------------
    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Floor>
        float3 xformOp:translate = (0, -0.02, -0.8)
        float3 xformOp:scale = (3.52, 0.04, 3.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Ceiling>
        float3 xformOp:translate = (0, 2.82, -0.8)
        float3 xformOp:scale = (3.52, 0.04, 3.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "BackWall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Wall>
        float3 xformOp:translate = (0, 1.4, -2.63)
        float3 xformOp:scale = (3.52, 2.8, 0.06)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "RightWall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Wall>
        float3 xformOp:translate = (1.73, 1.4, -0.8)
        float3 xformOp:scale = (0.06, 2.8, 3.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "LeftWall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Wall>
        float3 xformOp:translate = (-1.73, 1.4, -0.8)
        float3 xformOp:scale = (0.06, 2.8, 3.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    # ------------------------------------------------------------------------------------------
    # Ceiling light strips, one over each table.
    # ------------------------------------------------------------------------------------------
    def Cube "LightStrip_Front" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/LightStrip>
        float3 xformOp:translate = (0, 2.795, -0.95)
        float3 xformOp:scale = (2.2, 0.01, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "LightStrip_Back" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/LightStrip>
        float3 xformOp:translate = (0, 2.795, -2)
        float3 xformOp:scale = (2.2, 0.01, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    # ------------------------------------------------------------------------------------------
    # Display tables: 1.9 m maple slabs on trestle legs. The front one is 0.8 m deep with
    # its top at 0.82 m and a 5 cm riser along its back; the back one is 0.6 m deep, its
    # top at 0.95 m so its row shows over the front table's.
    # ------------------------------------------------------------------------------------------
    def Cube "FrontTable_Top" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Maple>
        float3 xformOp:translate = (0, 0.795, -0.95)
        float3 xformOp:scale = (1.9, 0.05, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "FrontTable_Leg_Left" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Maple>
        float3 xformOp:translate = (-0.83, 0.385, -0.95)
        float3 xformOp:scale = (0.06, 0.77, 0.68)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "FrontTable_Leg_Right" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Maple>
        float3 xformOp:translate = (0.83, 0.385, -0.95)
        float3 xformOp:scale = (0.06, 0.77, 0.68)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "FrontTable_Riser" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Riser>
        float3 xformOp:translate = (0, 0.845, -1.15)
        float3 xformOp:scale = (1.8, 0.05, 0.24)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "BackTable_Top" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Maple>
        float3 xformOp:translate = (0, 0.925, -2)
        float3 xformOp:scale = (1.9, 0.05, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "BackTable_Leg_Left" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Maple>
        float3 xformOp:translate = (-0.83, 0.45, -2)
        float3 xformOp:scale = (0.06, 0.9, 0.48)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "BackTable_Leg_Right" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/Maple>
        float3 xformOp:translate = (0.83, 0.45, -2)
        float3 xformOp:scale = (0.06, 0.9, 0.48)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    # ------------------------------------------------------------------------------------------
    # Wall rack on the right wall: a dark panel, 1.75 m wide and 1.65 m high.
    # ------------------------------------------------------------------------------------------
    def Cube "Rack_Panel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Root/Materials/RackPanel>
        float3 xformOp:translate = (1.68, 1.3, -0.2)
        float3 xformOp:scale = (0.04, 1.65, 1.75)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    # ------------------------------------------------------------------------------------------
    # Anchors. Empty; code places models, panels and lights at them.
    # Orient is (w, x, y, z): ±90° about Y turns +Z to face out of the side walls.
    # ------------------------------------------------------------------------------------------
    def Xform "Anchor_TableFront"
    {
        # Center of the front table top; displays line up along local X.
        float3 xformOp:translate = (0, 0.82, -0.95)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Anchor_TableBack"
    {
        # Center of the back table top.
        float3 xformOp:translate = (0, 0.95, -2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Anchor_WallRack"
    {
        # Center of the rack panel's face, facing -X into the room.
        float3 xformOp:translate = (1.655, 1.3, -0.2)
        quatf xformOp:orient = (0.70710677, 0, -0.70710677, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }
}
