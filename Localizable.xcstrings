    "Shows a saved offline map over the covered area, so it still works without an internet connection." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeigt eine gesicherte Offlinekarte über dem abgedeckten Bereich an, damit sie auch ohne Internetverbindung funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un mapa guardado sin conexión sobre el área cubierta, por lo que sigue funcionando sin conexión a Internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Affiche une carte hors ligne enregistrée sur la zone couverte, pour qu’elle fonctionne même sans connexion Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra una mappa offline salvata sull’area coperta, così funziona anche senza connessione a internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保存済みのオフラインマップを対象領域に表示するため、インターネットに接続していなくても使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 영역에 저장된 오프라인 지도를 표시하여 인터넷에 연결되어 있지 않아도 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra um mapa off-line salvo sobre a área coberta, para que ele funcione mesmo sem conexão com a internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывает сохраненную офлайн-карту поверх покрытой области, чтобы карта работала и без подключения к интернету."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує збережену офлайн-мапу поверх покритої області, тож вона працює без інтернет-з’єднання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在覆盖区域上显示已存储的离线地图，即使没有互联网连接也能使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在涵蓋區域上顯示已儲存的離線地圖，即使沒有網際網路連線也能使用。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在涵蓋區域上顯示已儲存的離線地圖，因此在沒有網際網路連線的情況下仍可運作。"
          }
        }
      }
    },
    "Shows direction and distance to a node based on GPS positions. Requires both your device and the remote node to share location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt die Richtung und Entfernung zu einem Knoten basierend auf GPS-Positionen. Erfordert, dass sowohl dein Gerät als auch der entfernte Knoten die Standortdaten teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la dirección y la distancia a un nodo basado en las posiciones GPS. Requiere que tanto tu dispositivo como el nodo remoto compartan su ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Affiche la direction et la distance vers un nœud en fonction des positions GPS. Il faut que votre appareil et le nœud distant partagent leur localisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mostra la direzione e la distanza verso un nodo in base alle posizioni GPS. Richiede che sia il tuo dispositivo e il nodo remoto a condividere la posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GPS位置に基づいてノードの方向と距離を表示します。デバイスの両方が位置を共有する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS 위치를 기반으로 노드까지의 방향과 거리를 표시합니다. 사용 중인 장치와 원격 노드 모두 위치를 공유해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mostra a direção e a distância para um nó com base nas posições GPS. Requer que ambos os dispositivos compartilhem a localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывает направление и расстояние до ноды по позициям GPS. Ваше устройство и удаленная нода должны делиться местоположением."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує напрямок і відстань до вузла на основі GPS-позицій. Потрібно, щоб і ваш пристрій, і віддалений вузол ділилися місцезнаходженням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "根据GPS位置显示节点方向和距离。需要您的设备和远程节点共享位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "顯示對節點的導航方向和距離，根據GPS位置計算。需要您的設備和遠端節點共享位置。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據 GPS 位置顯示到節點的方向與距離。需要您的裝置和遠端節點都分享位置。"
          }
        }
      }
    },
    "Shows saved maps over covered areas. They also appear automatically when iOS has no network route." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeigt gesicherte Karten über abgedeckten Bereichen an. Sie erscheinen auch automatisch, wenn iOS keine Netzwerkroute hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
