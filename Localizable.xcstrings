    "Save the connected node's full configuration (radio, module, and channel settings) to a file you can back up or import on another device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Speichere die vollständige Konfiguration des verbundenen Knotens (Funkgerät-, Modul- und Kanaleinstellungen) in einer Datei, die du sichern oder auf einem anderen Gerät importieren kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la configuración completa del nodo conectado (ajustes de radio, módulo y canal) en un archivo que puedas importar en otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistrez la configuration complète du nœud connecté (réglages de la radio, des modules et des canaux) dans un fichier que vous pouvez sauvegarder ou importer sur un autre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salva la configurazione completa del nodo connesso (impostazioni di radio, moduli e canali) in un file di cui puoi eseguire il backup o che puoi importare su un altro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "接続中のノードのすべての設定（無線、モジュール、チャンネルの設定）をファイルに保存します。このファイルはバックアップしたり、別のデバイスでインポートしたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "연결된 노드의 전체 설정(무선, 모듈 및 채널 설정)을 파일로 저장합니다. 이 파일은 백업하거나 다른 장치에서 가져올 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salve a configuração completa do nó conectado (configurações de rádio, módulo e canal) em um arquivo para fazer backup ou importar em outro dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сохраните полную конфигурацию подключенной ноды (настройки радио, модулей и каналов) в файл, который можно сохранить как резервную копию или импортировать на другом устройстве."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Збережіть повну конфігурацію підключеного вузла (налаштування радіо, модулів і каналів) у файл, який можна зберегти як резервну копію або імпортувати на іншому пристрої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将已连接节点的完整配置（电台、模块和频道设置）保存到文件，以便备份或在其他设备上导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將已連線節點的完整設定（無線電、模組和頻道設定）儲存為檔案，以便備份或在其他設備上匯入。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將已連線節點的完整設定（無線電、模組和頻道設定）儲存到您可以備份或在另一台裝置上匯入的檔案。"
          }
        }
      }
    },
