    "meshtastic.ClientNotification.NotificationType.DUPLICATED_PUBLIC_KEY.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.DUPLICATED_PUBLIC_KEY",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein entferntes Gerät hat deinen öffentlichen Schlüssel verbreitet. Dein Schlüssel ist möglicherweise kompromittiert; erwäge, ihn neu zu erzeugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A remote device has advertised your public key. Your key may be compromised; consider regenerating it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un dispositivo remoto ha anunciado tu clave pública. Es posible que tu clave esté comprometida; considera regenerarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un appareil distant a annoncé votre clé publique. Votre clé est peut-être compromise ; envisagez de la régénérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un dispositivo remoto ha annunciato la tua chiave pubblica. La tua chiave potrebbe essere compromessa; valuta di rigenerarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リモートデバイスが自分の公開鍵をアドバタイズしています。鍵が漏洩している可能性があるため、再生成を検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "원격 장치가 사용자의 공개 키를 브로드캐스트했습니다. 키가 노출되었을 수 있으므로 키를 다시 생성하는 것이 좋습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zdalne urządzenie rozgłosiło Twój klucz publiczny. Twój klucz mógł zostać przejęty; rozważ wygenerowanie nowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um dispositivo remoto anunciou a sua chave pública. Sua chave pode estar comprometida; considere gerar uma nova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Удаленное устройство объявило ваш открытый ключ. Ключ может быть скомпрометирован; рекомендуется сгенерировать его заново."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Віддалений пристрій оголосив ваш відкритий ключ. Ключ може бути скомпрометовано; варто згенерувати його повторно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有远程设备广播了您的公钥。您的密钥可能已泄露，建议重新生成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有遠端設備廣播了您的公鑰。您的金鑰可能已外洩，建議重新產生。"
          }
        },
        "zh-Hant-TW" : {
