    "Sweep modem presets to find nearby nodes, or analyze your current preset from everything you've already collected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durchlaufe die Modem-Voreinstellungen, um Knoten in der Nähe zu finden, oder analysiere deine aktuelle Voreinstellung anhand von allem, was du bereits gesammelt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barrido con los ajustes preestablecidos del módem para encontrar nodos cercanos, o analiza tu ajuste actual de todo lo que ya has recopilado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Parcourez les préréglages de modem pour trouver des nœuds à proximité, ou analysez votre préréglage actuel à partir de toutes les données déjà collectées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prova in sequenza i preset modem per trovare nodi vicini, oppure analizza il preset attuale con tutti i dati già raccolti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "モデムプリセットを順に切り替えて近くのノードを探すか、これまでに収集したすべてのデータから現在のプリセットを分析します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "모뎀 프리셋을 차례로 검색하여 주변 노드를 찾거나, 이미 수집한 모든 데이터로 현재 프리셋을 분석합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeskanuj presety modemu, aby znaleźć węzły w pobliżu, albo przeanalizuj bieżący preset na podstawie już zebranych danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Percorra os presets de modem para encontrar nós próximos ou analise o seu preset atual com tudo o que você já coletou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Переберите пресеты модема, чтобы найти ноды поблизости, или проанализируйте текущий пресет на основе всех уже собранных данных."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Переберіть пресети модема, щоб знайти вузли поблизу, або проаналізуйте поточний пресет на основі всього вже зібраного."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "依次扫描各个模组预设以查找附近的节点，或根据已收集的全部数据分析当前预设。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
