    "meshtastic.ClientNotification.NotificationType.PROTECTED_NODE_LIMIT_REACHED.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.PROTECTED_NODE_LIMIT_REACHED",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Knoten kann nicht als Favorit markiert oder ignoriert werden, weil das Limit für geschützte Knoten erreicht ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The node can't be favorited or ignored because the protected-node limit is reached."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se puede marcar el nodo como favorito ni ignorarlo porque se ha alcanzado el límite de nodos protegidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible d’ajouter le nœud aux favoris ou de l’ignorer, car la limite de nœuds protégés est atteinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile aggiungere il nodo ai preferiti o ignorarlo perché è stato raggiunto il limite di nodi protetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "保護されたノードの上限に達したため、このノードをお気に入りに追加したり無視したりできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "보호된 노드 수가 한도에 도달하여 이 노드를 즐겨찾기에 추가하거나 무시할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie można dodać węzła do ulubionych ani go zignorować, bo osiągnięto limit chronionych węzłów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não é possível favoritar ou ignorar o nó porque o limite de nós protegidos foi atingido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Нельзя добавить ноду в избранное или игнорировать ее, так как достигнут лимит защищенных нод."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Неможливо додати вузол до вибраного або ігнорувати його, бо досягнуто ліміту захищених вузлів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已达到受保护节点数量上限，因此无法收藏或忽略此节点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已達受保護節點上限，因此無法將此節點加入最愛或忽略。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已達受保護節點上限，因此無法將此節點加入最愛或忽略。"
          }
        }
      }
    },
