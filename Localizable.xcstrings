    "Leave Frequency Slot empty and listeners work it out from the region, preset and channel name. Set it only if your mesh uses a different slot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lass „Frequenzslot“ leer, dann ermitteln Empfänger ihn aus Region, Voreinstellung und Kanalname. Lege ihn nur fest, wenn dein Mesh einen anderen Slot verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Leave Frequency Slot empty and listeners work it out from the region, preset and channel name. Set it only if your mesh uses a different slot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deje vacía la “Ranura de frecuencia” y los receptores la deducirán a partir de la región, el preajuste y el nombre del canal. Establézcala solo si su malla usa una ranura distinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Laissez « Slot de fréquence » vide et les auditeurs le déduiront de la région, du préréglage et du nom du canal. Ne le définissez que si votre réseau maillé utilise un autre slot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lascia vuoto “Slot di frequenza” e i ricevitori lo ricaveranno da regione, preset e nome del canale. Impostalo solo se la mesh usa uno slot diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“周波数スロット”を空欄のままにすると、受信側が地域、プリセット、およびチャンネル名から算出します。メッシュで別のスロットを使用している場合にのみ設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "주파수 슬롯을 비워 두면 수신 측에서 지역, 프리셋 및 채널 이름을 기반으로 슬롯을 계산합니다. 메시에서 다른 슬롯을 사용하는 경우에만 설정하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zostaw slot częstotliwości pusty, a odbiorcy ustalą go z regionu, presetu i nazwy kanału. Ustaw go tylko wtedy, gdy Twoja sieć używa innego slotu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deixe a “Faixa de Frequência” vazia e os ouvintes vão deduzi-la a partir da região, do preset e do nome do canal. Defina-a só se a sua mesh usar uma faixa diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Оставьте поле «Частотный слот» пустым, и приемники определят его по региону, пресету и имени канала. Задавайте его, только если ваша сеть использует другой слот."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Залиште «Частотний слот» порожнім, і слухачі визначать його за регіоном, пресетом і назвою каналу. Установлюйте його, лише якщо ваша mesh-мережа використовує інший слот."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将“频谱”留空时，接收端会根据区域、预设和频道名称自行推算。仅当您的 Mesh 使用不同的槽位时才需设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「頻率信道」留空時，接收端會依據區域、預設值與頻道名稱自行推算。只有在您的網格使用不同信道時才需設定。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頻率槽位留空時，接收端會依據地區、預設值與頻道名稱自行推算。只有在 Mesh 使用不同槽位時才需設定。"
          }
        }
      }
    },
