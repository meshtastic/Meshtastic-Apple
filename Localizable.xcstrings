    "meshtastic.Config.LoRaConfig.tx_power.description" : {
      "comment" : "description of meshtastic.Config.LoRaConfig.tx_power",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sendeleistung des Funkgeräts. Belasse den Wert bei null, um die höchste in der Region zulässige Stufe zu verwenden – das ist für die meisten Funkgeräte die richtige Wahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Radio transmit power. Leave at zero to use the highest level legal for the region, which is what most radios should use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Potencia de transmisión de la radio. Déjala en cero para usar el nivel más alto permitido en la región, que es lo que deberían usar la mayoría de las radios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puissance d’émission de la radio. Laissez la valeur à zéro pour utiliser le niveau le plus élevé autorisé dans la région, ce qui convient à la plupart des radios."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Potenza di trasmissione della radio. Lascia il valore a zero per usare il livello più alto consentito nella regione, che è la scelta adatta per la maggior parte delle radio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無線機の送信出力。0のままにすると、その地域で法令上認められている最大レベルが使用されます。ほとんどの無線機ではこの設定が適しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "무선 장치의 송신 출력입니다. 0으로 두면 해당 지역에서 법적으로 허용되는 최고 출력을 사용하며, 대부분의 무선 장치에는 이 설정이 적합합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moc nadawania radia. Zostaw zero, aby użyć najwyższego poziomu dozwolonego w regionie — tego powinna używać większość radiów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Potência de transmissão do rádio. Deixe em zero para usar o nível mais alto permitido na região, que é o recomendado para a maioria dos rádios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Мощность передачи радиостанции. Оставьте ноль, чтобы использовать максимальный уровень, разрешенный в регионе, — это подходит для большинства радиостанций."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Потужність передавання радіостанції. Залиште нуль, щоб використовувати найвищий рівень, дозволений у регіоні, — це підходить для більшості радіостанцій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "电台发射功率。保持为 0 即可使用该地区法规允许的最高功率，大多数电台都应使用此设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無線電發射功率。保持為0即使用該區域法規允許的最高功率，大多數無線電都應使用此設定。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無線電發射功率。保持為 0 即使用該地區法規允許的最高功率，大多數無線電都應如此設定。"
          }
        }
      }
    },
