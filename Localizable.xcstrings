    "INFO_UF2.TXT has no Board-ID line, so the board cannot be identified safely." : {
      "comment" : "Error message when the INFO_UF2.TXT file on the bootloader drive does not contain a valid Board-ID.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "INFO_UF2.TXT enthält keine Board-ID-Zeile, daher kann das Board nicht sicher erkannt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo INFO_UF2.TXT no tiene una línea de Board-ID, por lo que no se puede identificar la placa de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "INFO_UF2.TXT ne contient pas de ligne Board-ID ; la carte ne peut donc pas être identifiée de façon sûre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "INFO_UF2.TXT non contiene una riga Board-ID, quindi non è possibile identificare la scheda in modo sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "INFO_UF2.TXTにBoard-IDの行がないため、ボードを安全に識別できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
