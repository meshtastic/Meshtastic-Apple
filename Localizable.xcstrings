          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "與無線電的Bluetooth連線已中斷。偏好的無線電重新開機或完成重新啟動後，將自動重新連線。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與無線電的藍牙連線已中斷，當無線電重新開機或完成重新啟動後，將自動重新連線至偏好的無線電。"
          }
        }
      }
    },
    "The connected radio or this node's user record is missing, so nothing was saved." : {
