    "\"%@\" is a reserved module channel name and will not appear in the Messages channel list. Pick a different name for a messaging channel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ ist ein reservierter Modulkanalname und erscheint nicht in der Kanalliste unter „Nachrichten“. Wähle einen anderen Namen für einen Nachrichtenkanal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" Es un nombre de canal de módulo reservado y no aparecerá en la lista de canales de Mensajes. Elija un nombre diferente para un canal de mensajería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« %@ » est un nom de canal réservé aux modules et n’apparaîtra pas dans la liste des canaux de Messages. Choisissez un autre nom pour un canal de messagerie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” è un nome di canale riservato ai moduli e non apparirà nell’elenco dei canali di Messaggi. Scegli un nome diverso per un canale di messaggistica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”はモジュール用に予約されたチャンネル名のため、“メッセージ”のチャンネルリストには表示されません。メッセージ用のチャンネルには別の名前を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”은(는) 예약된 모듈 채널 이름이므로 메시지 채널 목록에 표시되지 않습니다. 메시지 채널에는 다른 이름을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” é um nome de canal reservado para módulos e não aparecerá na lista de canais de Mensagens. Escolha outro nome para um canal de mensagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» — зарезервированное имя канала модуля, оно не появится в списке каналов в разделе «Сообщения». Выберите другое имя для канала сообщений."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» — це зарезервована назва каналу модуля, тому вона не з’явиться в списку каналів «Повідомлення». Виберіть іншу назву для каналу повідомлень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”是保留的模块频道名称，不会显示在“消息”频道列表中。请为消息频道选择其他名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」是保留的模組頻道名稱，不會出現在「訊息」頻道列表中。請為訊息頻道選擇其他名稱。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」是保留的模組頻道名稱，不會出現在訊息頻道列表中。請為訊息頻道選擇其他名稱。"
          }
        }
      }
    },
