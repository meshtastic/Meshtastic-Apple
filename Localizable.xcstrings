    "meshtastic.ClientNotification.NotificationType.UNSIGNED_IDENTITY_UPDATE_IGNORED.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.UNSIGNED_IDENTITY_UPDATE_IGNORED",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein unsigniertes Update wollte den Namen oder die Rolle eines bekannten Knotens ändern und wurde wegen deiner Sicherheitseinstellung ignoriert. Entferne den Knoten, um seine unsignierten Updates zu akzeptieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An unsigned update tried to change a known node's name or role and was ignored because of your security setting. Remove the node to accept its unsigned updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Una actualización sin firmar intentó cambiar el nombre o el rol de un nodo conocido y se ignoró por tu ajuste de seguridad. Elimina el nodo para aceptar sus actualizaciones sin firmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Une mise à jour non signée a tenté de modifier le nom ou le rôle d’un nœud connu et a été ignorée en raison de votre réglage de sécurité. Supprimez le nœud pour accepter ses mises à jour non signées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un aggiornamento non firmato ha tentato di modificare il nome o il ruolo di un nodo conosciuto ed è stato ignorato a causa delle tue impostazioni di sicurezza. Rimuovi il nodo per accettarne gli aggiornamenti non firmati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "署名なしの更新が既知のノードの名前または役割を変更しようとしましたが、セキュリティ設定により無視されました。このノードの署名なしの更新を受け入れるには、ノードを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "서명되지 않은 업데이트가 알려진 노드의 이름이나 역할을 변경하려 했으나 사용자의 보안 설정에 따라 무시되었습니다. 이 노드의 서명되지 않은 업데이트를 허용하려면 노드를 삭제하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Niepodpisana aktualizacja próbowała zmienić nazwę lub rolę znanego węzła i została zignorowana z powodu ustawień bezpieczeństwa. Usuń węzeł, aby akceptować jego niepodpisane aktualizacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uma atualização sem assinatura tentou mudar o nome ou a função de um nó conhecido e foi ignorada por causa da sua configuração de segurança. Remova o nó para aceitar as atualizações sem assinatura dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Неподписанное обновление пыталось изменить имя или роль известной ноды и было проигнорировано из-за ваших настроек безопасности. Чтобы принимать неподписанные обновления этой ноды, удалите ее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Непідписане оновлення намагалося змінити ім’я або роль відомого вузла, але його проігноровано через налаштування безпеки. Щоб приймати непідписані оновлення цього вузла, видаліть його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有未签名的更新试图更改已知节点的名称或角色，因您的安全设置而被忽略。移除该节点即可接受其未签名的更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有未簽署的更新試圖變更已知節點的名稱或角色，因您的安全性設定而被忽略。若要接受該節點未簽署的更新，請移除該節點。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有未簽署的更新試圖變更已知節點的名稱或角色，因您的安全性設定而被忽略。移除該節點即可接受其未簽署的更新。"
          }
        }
      }
    },
