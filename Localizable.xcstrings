    "Address, gateway and subnet are required and must be valid IPv4 addresses. DNS may be left blank." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adresse, Gateway und Subnetz sind erforderlich und müssen gültige IPv4-Adressen sein. DNS kann leer bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La dirección, la puerta de enlace y la subred son obligatorias y deben ser direcciones IPv4 válidas. El campo DNS puede dejarse en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’adresse, la passerelle et le sous-réseau sont obligatoires et doivent être des adresses IPv4 valides. Le champ DNS peut rester vide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indirizzo, gateway e subnet sono obbligatori e devono essere indirizzi IPv4 validi. Il campo DNS può essere lasciato vuoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "アドレス、ゲートウェイ、およびサブネットは必須で、有効なIPv4アドレスである必要があります。DNSは空欄のままでもかまいません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "주소, 게이트웨이 및 서브넷은 필수이며 유효한 IPv4 주소여야 합니다. DNS는 비워 둘 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adres, brama i maska podsieci są wymagane i muszą być poprawnymi adresami IPv4. DNS można zostawić puste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Endereço, gateway e sub-rede são obrigatórios e devem ser endereços IPv4 válidos. O DNS pode ficar em branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Адрес, шлюз и подсеть обязательны и должны быть действительными адресами IPv4. DNS можно оставить пустым."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Адреса, шлюз і підмережа обов’язкові й мають бути дійсними адресами IPv4. DNS можна залишити порожнім."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "地址、网关和子网为必填项，且必须是有效的 IPv4 地址。DNS 可以留空。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "地址、閘道和子網路為必填項目，且必須是有效的IPv4地址。DNS可以留空。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位址、閘道和子網路為必填項，且必須是有效的 IPv4 位址。DNS 可以留空。"
          }
        }
      }
    },
