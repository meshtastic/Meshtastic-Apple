    "meshtastic.ModuleConfig.TrafficManagementConfig.unknown_packet_threshold.description" : {
      "comment" : "description of meshtastic.ModuleConfig.TrafficManagementConfig.unknown_packet_threshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nicht entschlüsselbare Pakete, die ein Knoten in 5 Minuten senden darf, bevor er verworfen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Undecryptable packets one node may send in 5 minutes before it is dropped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Paquetes indescifrables que un nodo puede enviar en 5 minutos antes de que se descarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nombre de paquets indéchiffrables qu’un nœud peut envoyer en 5 minutes avant que ses paquets ne soient rejetés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pacchetti non decifrabili che un nodo può inviare in 5 minuti prima di essere scartato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "1つのノードが5分間に送信できる復号できないパケットの数。これを超えると、そのノードのパケットは破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "한 노드가 5분 동안 보낼 수 있는 복호화할 수 없는 패킷 수입니다. 이 수를 넘으면 해당 노드의 패킷은 버려집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ile pakietów nie do odszyfrowania jeden węzeł może wysłać w 5 minut, zanim zostanie odrzucony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pacotes que não podem ser descriptografados que um nó pode enviar em 5 minutos antes de ser descartado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сколько нерасшифровываемых пакетов одна нода может отправить за 5 минут, прежде чем их начнут отбрасывать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Скільки пакетів, які не вдається розшифрувати, один вузол може надіслати за 5 хвилин, перш ніж їх почнуть відкидати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "单个节点在 5 分钟内可发送的无法解密数据包数量上限，超过后将丢弃该节点的数据包。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "單一節點在5分鐘內可傳送的無法解密封包數量上限，超過後將捨棄該節點的封包。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單一節點在 5 分鐘內可傳送的無法解密封包數量上限，超過後將捨棄該節點的封包。"
          }
        }
      }
    },
