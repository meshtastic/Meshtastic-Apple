        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請注意，由於地圖報告內容未經加密，您的資料可能會被第三方永久儲存、展示或公開揭露。Meshtastic 對於任何此類資料的儲存、展示或揭露行為，不承擔任何責任。"
          }
        }
      }
    },
