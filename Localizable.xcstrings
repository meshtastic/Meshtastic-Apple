        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "무선 장치의 이웃 노드 정보 모듈이 꺼져 있어 다른 노드 간의 링크를 표시할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
