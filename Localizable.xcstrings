        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua posição foi enviada com uma solicitação de resposta com sua posição. Você receberá uma notificação quando uma posição for retornada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша позиция была отправлена с запросом на ответ с указанием их позиции. Вы получите уведомление, когда позиция будет возвращена."
          }
        },
        "sr" : {
          "stringUnit" : {
