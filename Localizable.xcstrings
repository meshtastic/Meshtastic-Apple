            "value" : "Moduł Info o sąsiadach w Twoim radiu jest wyłączony, więc nie można pokazać połączeń między innymi węzłami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O módulo Informações de Vizinhos do seu rádio está desativado, então não é possível mostrar os enlaces entre outros nós."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Модуль «Информация о соседях» на радиостанции выключен, поэтому связи между другими нодами показать нельзя."
          }
        },
        "uk" : {
          "stringUnit" : {
