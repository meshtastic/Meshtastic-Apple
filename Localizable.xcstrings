    "Bluetooth Low Energy supports background connections. When possible, the application will remain connected to these accessories while the app is in the background." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energy unterstützt Verbindungen im Hintergrund. Wenn möglich, bleibt die App mit diesen Geräten verbunden, während sie im Hintergrund läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energy admite conexiones en segundo plano. Cuando sea posible, la app permanecerá conectada a estos accesorios mientras esté en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energy prend en charge les connexions en arrière-plan. Lorsque c’est possible, l’app reste connectée à ces accessoires pendant qu’elle est en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energy supporta le connessioni in background. Quando possibile, l’app resterà connessa a questi accessori mentre è in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energyはバックグラウンド接続に対応しています。可能な場合、アプリがバックグラウンドにある間もこれらのアクセサリとの接続を維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energy는 백그라운드 연결을 지원합니다. 가능한 경우 앱이 백그라운드에 있는 동안에도 이 액세서리와의 연결을 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth Low Energy obsługuje połączenia w tle. Gdy to możliwe, aplikacja pozostanie połączona z tymi akcesoriami, nawet gdy działa w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O Bluetooth Low Energy permite conexões em segundo plano. Quando possível, o aplicativo permanece conectado a esses acessórios enquanto estiver em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energy поддерживает фоновые подключения. По возможности приложение будет оставаться подключенным к этим аксессуарам, пока оно работает в фоновом режиме."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energy підтримує фонові підключення. Коли можливо, застосунок залишатиметься підключеним до цих аксесуарів, поки працює у фоні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energy 支持后台连接。在可能的情况下，App 在后台运行时将与这些配件保持连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth Low Energy支援背景連線。在可能的情況下，應用程式在背景執行時會與這些配件保持連線。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "藍牙低功耗支援背景連線。在可能的情況下，當應用程式在背景執行時，將保持與這些配件的連線。"
          }
        }
      }
    },
    "Bluetooth radio %@\n\nChoose the radio on Connect." : {
      "comment" : "Connect link prompt for a Bluetooth radio without a PIN; the value is its Bluetooth address",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth-Funkgerät %@\n\nWähle das Funkgerät unter „Verbinden“ aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Radio Bluetooth %@\n\nElige la radio en Conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
