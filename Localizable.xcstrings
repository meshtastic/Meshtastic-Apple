    "This node has not shared a public key, so direct messages to it cannot be sent. Exchange User Info asks for one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Knoten hat keinen öffentlichen Schlüssel geteilt, daher können keine Direktnachrichten an ihn gesendet werden. „Benutzerinformationen austauschen“ fordert einen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este nodo no ha compartido una clave pública, por lo que no es posible enviarle mensajes directos. El Intercambio de Información de Usuario la solicita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce nœud n’a pas partagé de clé publique ; il est donc impossible de lui envoyer des messages directs. « Échange d’informations utilisateur » en demande une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo nodo non ha condiviso una chiave pubblica, quindi non è possibile inviargli messaggi diretti. “Scambio Informazioni Utente” ne richiede una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
