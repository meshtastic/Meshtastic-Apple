    "The Meshtastic App can connect to and manage network-enabled nodes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Meshtastic-App kann sich mit netzwerkfähigen Knoten verbinden und sie verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La app Meshtastic puede conectarse a nodos con conexión de red y administrarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’app Meshtastic peut se connecter aux nœuds disposant d’une connexion réseau et les gérer."
