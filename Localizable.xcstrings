          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最可靠的訊息體驗是使用藍牙低功耗連線的節點。"
          }
        }
      }
    },
    "The owner, channels, identity keys, settings, Bluetooth bonds, and node database are permanently removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Besitzer, Kanäle, Identitätsschlüssel, Einstellungen, Bluetooth-Kopplungen und Knotendatenbank werden dauerhaft entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El propietario, los canales, las claves de identidad, la configuración, las vinculaciones Bluetooth y la base de datos de nodos se eliminan permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le propriétaire, les canaux, les clés d’identité, les réglages, les jumelages Bluetooth et la base de données des nœuds sont définitivement supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Proprietario, canali, chiavi di identità, impostazioni, associazioni Bluetooth e database dei nodi vengono rimossi in modo permanente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所有者、チャンネル、識別キー、設定、Bluetoothペアリング、およびノードデータベースが完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "소유자, 채널, ID 키, 설정, Bluetooth 페어링 및 노드 데이터베이스가 영구적으로 삭제됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Właściciel, kanały, klucze tożsamości, ustawienia, powiązania Bluetooth i baza węzłów zostaną trwale usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O dono, os canais, as chaves de identidade, as configurações, os emparelhamentos Bluetooth e o banco de dados de nós são removidos permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Владелец, каналы, ключи идентификации, настройки, связи Bluetooth и база данных нод будут безвозвратно удалены."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Власника, канали, ключі ідентифікації, налаштування, Bluetooth-пари та базу вузлів буде видалено назавжди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所有者、频道、身份密钥、设置、Bluetooth 配对和节点数据库将被永久移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "擁有者、頻道、身分金鑰、設定、Bluetooth配對和節點資料庫會被永久移除。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擁有者、頻道、身分金鑰、設定、藍牙配對和節點資料庫將被永久移除。"
          }
        }
      }
    },
    "The radio did not reboot, so there is no fresh configuration to check against." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
