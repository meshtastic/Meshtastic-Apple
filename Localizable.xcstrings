    "meshtastic.Config.DeviceConfig.RebroadcastMode.ALL.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.RebroadcastMode.ALL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Leitet jede beobachtete Nachricht weiter, wenn sie auf unserem privaten Kanal oder von einem anderen Kanal mit denselben LoRa-Einstellungen kam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rebroadcast any observed message, if it was on our private channel or from another channel with the same LoRa settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retransmite cualquier mensaje observado si estaba en nuestro canal privado o procedía de otro canal con los mismos ajustes LoRa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retransmet tout message observé s’il provenait de notre canal privé ou d’un autre canal utilisant les mêmes réglages LoRa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ritrasmette qualsiasi messaggio osservato, se era sul nostro canale privato o proveniva da un altro canale con le stesse impostazioni LoRa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "受信したメッセージが自分のプライベートチャンネル上のもの、または同じLoRa設定を持つ別のチャンネルからのものであれば、すべて再ブロードキャストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "수신한 메시지가 자체 비공개 채널에 있거나 LoRa 설정이 같은 다른 채널에서 온 경우 모두 중계합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przekazuje każdą usłyszaną wiadomość, jeśli była na naszym prywatnym kanale albo na innym kanale z tymi samymi ustawieniami LoRa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retransmite qualquer mensagem observada se ela estava no nosso canal privado ou veio de outro canal com as mesmas configurações LoRa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ретранслирует любое замеченное сообщение, если оно было на нашем приватном канале или пришло из другого канала с теми же настройками LoRa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ретранслює будь-яке помічене повідомлення, якщо воно було на нашому приватному каналі або з іншого каналу з тими самими налаштуваннями LoRa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "转发观察到的任何消息，只要它来自我们的私有频道，或来自具有相同 LoRa 设置的其他频道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "轉發收到的任何訊息，只要該訊息來自我們的私人頻道，或來自LoRa設定相同的其他頻道。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉發任何觀察到的訊息，只要它位於我們的私人頻道上，或來自具有相同 LoRa 設定的其他頻道。"
          }
        }
      }
    },
