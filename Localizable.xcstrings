    "meshtastic.ClientNotification.NotificationType.MQTT_SERVER_UNREACHABLE.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.MQTT_SERVER_UNREACHABLE",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der MQTT-Server war nicht erreichbar. Die Einstellungen wurden gespeichert; überprüfe Serveradresse und Zugangsdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The MQTT server could not be reached. Settings were saved; check the server address and credentials."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se ha podido conectar con el servidor MQTT. Los ajustes se han guardado; comprueba la dirección del servidor y las credenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible de joindre le serveur MQTT. Les réglages ont été enregistrés ; vérifiez l’adresse du serveur et les identifiants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile raggiungere il server MQTT. Le impostazioni sono state salvate; verifica l’indirizzo del server e le credenziali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MQTTサーバに接続できませんでした。設定は保存されました。サーバアドレスと認証情報を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MQTT 서버에 연결할 수 없습니다. 설정은 저장되었습니다. 서버 주소와 자격 증명을 확인하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie udało się połączyć z serwerem MQTT. Ustawienia zapisano; sprawdź adres serwera i dane logowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível acessar o servidor MQTT. As configurações foram salvas; verifique o endereço do servidor e as credenciais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось подключиться к MQTT-серверу. Настройки сохранены; проверьте адрес сервера и учетные данные."
          }
        },
        "uk" : {
