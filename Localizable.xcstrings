    "The recipient does not know your public key yet. Your node may share its info automatically; try again after it syncs." : {
      "comment" : "RoutingError.description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Empfänger kennt deinen öffentlichen Schlüssel noch nicht. Dein Knoten teilt seine Infos eventuell automatisch; versuche es nach der Synchronisierung erneut."
