    "The update loader on this device does not support this connection. A full install with the Web Flasher over USB replaces it." : {
      "comment" : "OTA refused: the installed OTA loader does not support this transport",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Update-Loader auf diesem Gerät unterstützt diese Verbindung nicht. Eine vollständige Installation mit dem Web Flasher über USB ersetzt ihn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El actualizador de este dispositivo no admite esta conexión. Una instalación completa mediante Web Flasher a través de USB lo reemplaza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le chargeur de mise à jour de cet appareil ne prend pas en charge cette connexion. Une installation complète avec le Web Flasher via USB le remplace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il caricatore di aggiornamento di questo dispositivo non supporta questa connessione. Un’installazione completa con il Web Flasher tramite USB lo sostituisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このデバイスのアップデートローダーはこの接続に対応していません。USB経由でWeb Flasherを使用してフルインストールすると、アップデートローダーが置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 장치의 업데이트 로더는 이 연결 방식을 지원하지 않습니다. USB를 통해 Web Flasher로 전체 설치를 하면 업데이트 로더가 교체됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Program aktualizujący na tym urządzeniu nie obsługuje tego połączenia. Pełna instalacja przez Web Flasher po USB go zastąpi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O carregador de atualização deste dispositivo não é compatível com esta conexão. Uma instalação completa com o Web Flasher via USB o substitui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Загрузчик обновления на этом устройстве не поддерживает такое подключение. Полная установка с помощью Web Flasher через USB заменит его."
          }
        },
        "uk" : {
          "stringUnit" : {
