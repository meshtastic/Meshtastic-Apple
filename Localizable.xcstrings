    "Background network connections are not supported and may disconnect when you leave the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Netzwerkverbindungen im Hintergrund werden nicht unterstützt und können getrennt werden, wenn du die App verlässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las conexiones de red en segundo plano no son compatibles y pueden desconectarse cuando sales de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les connexions réseau en arrière-plan ne sont pas prises en charge et peuvent être interrompues lorsque vous quittez l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le connessioni di rete in background non sono supportate e potrebbero interrompersi quando esci dall’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "バックグラウンドでのネットワーク接続には対応していないため、アプリを離れると接続が切れることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "백그라운드 네트워크 연결은 지원되지 않으며, 앱을 벗어나면 연결이 끊어질 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
