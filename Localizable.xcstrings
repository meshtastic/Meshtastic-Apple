    "meshtastic.Config.SecurityConfig.is_managed.description" : {
      "comment" : "description of meshtastic.Config.SecurityConfig.is_managed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enheden administreres af en mesh-administrator, brugeren har ikke adgang til enhedens indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Gerät wird von einem Mesh-Administrator verwaltet, der Benutzer kann keine der Geräteeinstellungen bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Settings are changed by a mesh administrator using an admin key, not from the local app. Needs at least one admin key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El dispositivo es administrado por un administrador de malla, el usuario no puede acceder a ninguna de las configuraciones del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'appareil est géré par un administrateur de réseau, l'utilisateur ne peut accéder à aucune des paramètres de l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il dispositivo è gestito da un amministratore di rete, ma l'utente non può accedere alle impostazioni del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "デバイスはメッシュ管理者によって管理されており、ユーザーはデバイス設定にアクセスできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "장치는 Mesh 관리자가 관리하며, 사용자는 장치의 어떤 설정에도 접근할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ustawienia zmienia administrator sieci za pomocą klucza administratora, a nie lokalna aplikacja. Wymaga co najmniej jednego klucza administratora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O dispositivo é gerenciado por um administrador de rede, o usuário não pode acessar nenhuma das configurações do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Устройством управляет администратор сети, пользователь не может получить доступ ни к одной настройке устройства."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Уређајем управља администратор мреже, корисник не може да приступи ниједном подешавању уређаја."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пристроєм керує адміністратор mesh-мережі; користувач не має доступу до налаштувань пристрою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "设备由 Mesh 管理员管理，用户无法访问任何设备设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "設備由網格管理員管理，使用者無法訪問任何設備設定。"
          }
        },
        "zh-Hant-TW" : {
