    "Enable broadcasting device metrics to the mesh network. When disabled, metrics are only sent to connected clients." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte die Übertragung von Gerätemesswerten in das Mesh-Netzwerk. Wenn deaktiviert, werden die Messwerte nur an angeschlossene Clients gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilita la difusión de métricas del dispositivo a la malla. Cuando está deshabilitado, las métricas solo se envían a los clientes conectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activer la diffusion des métriques du dispositif sur le réseau mesh. Lorsque cela est désactivé, les métriques sont envoyées uniquement aux clients connectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abilita la trasmissione dei metadati del dispositivo di trasmissione al rete mesh. Quando disabilitato, i metadati vengono inviati solo ai client connessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "メッシュネットワークにブロードキャストデバイスのメトリクスを有効にします。無効にすると、メトリクスは接続されたクライアントのみに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장치 측정 데이터를 Mesh 네트워크로 브로드캐스트할 수 있습니다. 비활성화하면 측정 데이터는 연결된 클라이언트에만 전송됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Włącz wysyłanie metryk urządzenia do sieci. Po wyłączeniu metryki trafiają tylko do połączonych klientów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ativar a transmissão de métricas do dispositivo para a rede de mesh. Quando desativado, as métricas são enviadas apenas para os clientes conectados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить передачу метрик устройства в ячеистую сеть. При отключении метрики отправляются только подключенным клиентам."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнути трансляцію метрик пристрою в mesh-мережу. Якщо вимкнено, метрики надсилаються лише підключеним клієнтам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "启用广播设备的网格网络指标。当禁用时，指标仅发送给已连接的客户端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "啟用傳播設備指標到鏈網。啟用時，指標僅會傳送給連接的客戶端。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用將裝置指標廣播到 Mesh 網路。停用時，指標只會傳送給已連線的客戶端。"
          }
        }
      }
    },
