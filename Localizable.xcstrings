    "Advertise your own mesh so people nearby can find and join it." : {
      "comment" : "Radio setup beacons page",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mache dein eigenes Mesh bekannt, damit Leute in der Nähe es finden und ihm beitreten können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anuncia tu propia malla para que las personas cercanas puedan encontrarla y unirse a ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annoncez votre propre réseau maillé afin que les personnes à proximité puissent le trouver et le rejoindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annuncia la tua mesh in modo che le persone vicine possano trovarla e unirsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "近くの人が見つけて参加できるように、自分のメッシュを告知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "근처 사람들이 찾아서 참여할 수 있도록 자신의 메시를 알립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozgłaszaj własną sieć, aby osoby w pobliżu mogły ją znaleźć i do niej dołączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anuncie sua própria mesh para que pessoas próximas possam encontrá-la e entrar nela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Объявляйте свою сеть, чтобы люди поблизости могли найти её и подключиться."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
