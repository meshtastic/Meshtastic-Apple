    "Could not open the session (%@). The node must list your radio's public key as an admin key, and be in range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sitzung konnte nicht geöffnet werden (%@). Der Knoten muss den öffentlichen Schlüssel deines Funkgeräts als Admin-Schlüssel eingetragen haben und in Reichweite sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo abrir la sesión (%@). El nodo debe tener la clave pública de tu radio como clave de administrador y estar dentro del alcance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible d’ouvrir la session (%@). Le nœud doit avoir la clé publique de votre radio parmi ses clés d’administration et être à portée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile aprire la sessione (%@). Il nodo deve avere la chiave pubblica della radio tra le chiavi amministrative ed essere nel raggio di portata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "セッションを開けませんでした（%@）。ノードに無線機の公開キーが管理者キーとして登録されていて、通信範囲内にある必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "세션을 열 수 없습니다(%@). 노드가 사용자 무선 장치의 공개 키를 관리자 키로 등록하고 있어야 하며 통신 범위 안에 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível abrir a sessão (%@). O nó precisa ter a chave pública do seu rádio como chave de administrador e estar dentro do alcance."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось открыть сеанс (%@). Нода должна иметь открытый ключ вашей радиостанции в качестве ключа администратора и находиться в зоне досягаемости."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не вдалося відкрити сеанс (%@). Вузол має містити відкритий ключ вашої радіостанції як ключ адміністратора й перебувати в зоні досяжності."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法打开会话（%@）。该节点必须已将您电台的公钥列为管理员密钥，并且位于通信范围内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法開啟工作階段（%@）。節點必須將您無線電的公鑰列為管理員金鑰，且位於通訊範圍內。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟工作階段（%@）。節點必須將您無線電的公鑰列為管理金鑰，且位於通訊範圍內。"
          }
        }
      }
    },
