    "Wrote %@. The device is installing the bootloader and will reboot on its own." : {
      "comment" : "A label that shows a checkmark and a message that the bootloader has been successfully installed. The argument is the name of the file that was written.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ geschrieben. Das Gerät installiert den Bootloader und startet von selbst neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabó %@. El dispositivo está instalando el gestor de arranque y se reiniciará automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ écrit. L’appareil installe le bootloader et redémarrera de lui-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ scritto. Il dispositivo sta installando il bootloader e si riavvierà automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@を書き込みました。デバイスはブートローダーをインストール中で、自動的に再起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@을(를) 썼습니다. 장치가 부트로더를 설치하는 중이며 자동으로 재부팅됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapisano %@. Urządzenie instaluje bootloader i samo się uruchomi ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ gravado. O dispositivo está instalando o bootloader e vai reiniciar sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Файл %@ записан. Устройство устанавливает загрузчик и перезагрузится само."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ записано. Пристрій установлює bootloader і перезапуститься самостійно."
          }
