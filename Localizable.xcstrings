    "%@'s bandwidth is not compliant in the US. The Turbo presets are recommended." : {
      "comment" : "LoRa preset warning; the argument is the preset's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Bandbreite von %@ ist in den USA nicht zulässig. Die Turbo-Voreinstellungen werden empfohlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El ancho de banda de %@ no cumple con las normativas de EE.UU. Se recomiendan los ajustes preestablecidos Turbo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La bande passante de %@ n’est pas conforme aux États-Unis. Les préréglages Turbo sont recommandés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La larghezza di banda di %@ non è conforme alle normative degli Stati Uniti. Si consigliano le preimpostazioni Turbo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@の帯域幅は米国の規制に準拠していません。Turboプリセットをおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@의 대역폭은 미국 규정에 맞지 않습니다. Turbo 프리셋을 권장합니다."
