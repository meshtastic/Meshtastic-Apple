    },
    "This revokes the current session and reboots the device locked. You will need the passphrase to reconnect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dadurch wird die aktuelle Sitzung widerrufen und das Gerät gesperrt neu gestartet. Du brauchst die Passphrase, um dich erneut zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto cancela la sesión actual y reinicia el dispositivo bloqueado. Necesitará la contraseña para volver a conectarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela révoque la session actuelle et redémarre l’appareil verrouillé. Vous aurez besoin de la phrase secrète pour vous reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La sessione attuale verrà revocata e il dispositivo verrà riavviato bloccato. Per riconnetterti ti servirà la passphrase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "現在のセッションを無効にし、デバイスをロックした状態で再起動します。再接続するにはパスフレーズが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "현재 세션을 취소하고 장치를 잠긴 상태로 재부팅합니다. 다시 연결하려면 암호가 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
