    "meshtastic.ClientNotification.NotificationType.LOW_ENTROPY_KEY_RESTORE_REJECTED.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.LOW_ENTROPY_KEY_RESTORE_REJECTED",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Schlüssel ist ein bekannter Schlüssel mit geringer Entropie und kann nicht wiederhergestellt werden. Ein neuer sicherer Schlüssel wurde erzeugt und die Knotennummer hat sich geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That key is a known low-entropy key and can't be restored. A new secure key was generated and the node number changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esa clave es una clave de baja entropía conocida y no se puede restaurar. Se ha generado una nueva clave segura y el número de nodo ha cambiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette clé est une clé à faible entropie connue et ne peut pas être restaurée. Une nouvelle clé sécurisée a été générée et le numéro de nœud a changé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questa chiave è una chiave nota a bassa entropia e non può essere ripristinata. È stata generata una nuova chiave sicura e il numero di nodo è cambiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このキーは既知の低エントロピーキーのため、復元できません。新しい安全なキーが生成され、ノード番号が変更されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 키는 알려진 저엔트로피 키이므로 복원할 수 없습니다. 새로운 보안 키가 생성되었으며 노드 번호가 변경되었습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To znany klucz o niskiej entropii i nie można go przywrócić. Wygenerowano nowy bezpieczny klucz, a numer węzła się zmienił."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Essa chave é uma chave conhecida de baixa entropia e não pode ser restaurada. Uma nova chave segura foi gerada e o número do nó mudou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этот ключ известен как ключ с низкой энтропией, и его нельзя восстановить. Создан новый безопасный ключ, а номер ноды изменился."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цей ключ відомий як ключ із низькою ентропією, і його не можна відновити. Згенеровано новий безпечний ключ, а номер вузла змінився."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "该密钥是已知的低熵密钥，无法恢复。已生成新的安全密钥，且节点编号已更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "該金鑰是已知的低熵金鑰，無法還原。已產生新的安全金鑰，且節點編號已變更。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該金鑰是已知的低熵金鑰，無法還原。已產生新的安全金鑰，且節點編號已變更。"
          }
        }
      }
    },
