    "meshtastic.ClientNotification.NotificationType.PACKET_SIGNATURE_POLICY_UNAVAILABLE.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.PACKET_SIGNATURE_POLICY_UNAVAILABLE",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Paketsignatur-Richtlinie ist in dieser Firmware-Version nicht verfügbar und wurde daher auf „Kompatibel“ gesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
