    "The admin session key is missing, expired, or invalid. Request a new session before trying again." : {
      "comment" : "RoutingError.description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Schlüssel der Admin-Sitzung fehlt, ist abgelaufen oder ungültig. Fordere eine neue Sitzung an, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Falta la clave de la sesión de administración, ha caducado o no es válida. Solicita una nueva sesión antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La clé de session d’administration est absente, expirée ou non valide. Demandez une nouvelle session avant de réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La chiave della sessione amministrativa è mancante, scaduta o non valida. Richiedi una nuova sessione prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "管理セッションキーがないか、有効期限が切れているか、無効です。新しいセッションを要求してから、やり直してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "관리자 세션 키가 없거나 만료되었거나 유효하지 않습니다. 다시 시도하기 전에 새 세션을 요청하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A chave da sessão de administração remota está ausente, expirou ou é inválida. Solicite uma nova sessão antes de tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ключ сеанса администратора отсутствует, истек или недействителен. Запросите новый сеанс, прежде чем повторить попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ключ сеансу адміністратора відсутній, його термін дії минув або він недійсний. Запросіть новий сеанс, перш ніж спробувати знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "管理员会话密钥缺失、已过期或无效。请先请求新的会话，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "管理工作階段金鑰遺失、已過期或無效。請先請求新的工作階段，然後再試一次。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理工作階段金鑰遺失、過期或無效。請在重試前請求新的工作階段。"
          }
        }
      }
    },
    "The amount of time to wait before we consider your packet as done." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tid vi venter, før vi anser din pakke som færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Zeit, die wir warten, bevor wir dein Paket als abgeschlossen betrachten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cantidad de tiempo que debemos esperar antes de que consideremos que su paquete está listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le temps de délai avant que nous considérions votre paquet comme terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo di attesa prima che il pacchetto venga considerato completato."
          }
        },
        "ja" : {
