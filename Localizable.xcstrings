    "meshtastic.Config.SecurityConfig.PacketSignaturePolicy.PACKET_SIGNATURE_POLICY_STRICT.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nur Pakete mit verifizierter Signatur oder erfolgreicher PKI-Entschlüsselung werden akzeptiert. Pakete von älteren Knoten werden möglicherweise ignoriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accept only packets with a verified signature or successful PKI decryption. Packets from older nodes may be ignored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Acepta solo paquetes con una firma verificada o descifrados correctamente con PKI. Es posible que se ignoren los paquetes de nodos más antiguos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accepte uniquement les paquets dont la signature est vérifiée ou dont le déchiffrement PKI a réussi. Les paquets des nœuds plus anciens peuvent être ignorés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accetta solo i pacchetti con una firma verificata o decifrati correttamente con PKI. I pacchetti dei nodi meno recenti potrebbero essere ignorati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "検証済みの署名があるパケット、またはPKIによる復号に成功したパケットのみを受け入れます。古いノードからのパケットは無視される場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "서명이 검증되었거나 PKI 복호화에 성공한 패킷만 허용합니다. 오래된 노드의 패킷은 무시될 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Akceptuj tylko pakiety ze zweryfikowanym podpisem lub poprawnie odszyfrowane przez PKI. Pakiety od starszych węzłów mogą być ignorowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aceita apenas pacotes com assinatura verificada ou descriptografia PKI bem-sucedida. Pacotes de nós mais antigos podem ser ignorados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Принимать только пакеты с проверенной подписью или успешно расшифрованные с помощью PKI. Пакеты от старых нод могут игнорироваться."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Приймає лише пакети з перевіреним підписом або успішно розшифровані за допомогою PKI. Пакети від старіших вузлів можуть ігноруватися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅接受签名已验证或 PKI 解密成功的数据包。来自较旧节点的数据包可能会被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "僅接受簽署已驗證或PKI解密成功的封包。來自較舊節點的封包可能會被忽略。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅接受已簽署的封包"
          }
        }
      }
    },
