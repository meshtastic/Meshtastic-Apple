    "meshtastic.ClientNotification.NotificationType.MANAGED_MODE_REQUIRES_ADMIN_KEY.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.MANAGED_MODE_REQUIRES_ADMIN_KEY",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der verwaltete Modus benötigt mindestens einen öffentlichen Admin-Schlüssel und bleibt daher deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Managed mode needs at least one admin public key, so it was left disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El modo administrado necesita al menos una clave pública de administración, por lo que se ha dejado desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le mode géré nécessite au moins une clé publique d’administration ; il est donc resté désactivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La modalità gestita richiede almeno una chiave pubblica amministrativa, quindi è rimasta disattivata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "管理モードには管理者公開鍵が1つ以上必要なため、無効のままになっています。"
