          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ne fermez pas l'application pendant l'update."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non chiudere l'app durante l'aggiornamento."
          }
