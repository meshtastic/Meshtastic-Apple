    "meshtastic.Config.LoRaConfig.tx_enabled.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erlaubt dem LoRa-Funkmodul zu senden. Schalte das beim Wechseln von Antennen im laufenden Betrieb oder bei Tests auf dem Prüfstand aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow the LoRa radio to transmit. Turn off while hot-swapping antennas or bench testing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permite que la radio LoRa transmita. Desactívalo mientras cambias antenas en caliente o haces pruebas en banco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorise la radio LoRa à émettre. Désactivez cette option lors du remplacement d’antennes sous tension ou des tests sur banc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Consente alla radio LoRa di trasmettere. Disattiva l’opzione durante la sostituzione a caldo delle antenne o i test al banco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "LoRa無線機の送信を許可します。通電中にアンテナを交換するときやベンチテストを行うときはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "LoRa 무선 장치의 송신을 허용합니다. 전원이 켜진 상태에서 안테나를 교체하거나 벤치 테스트를 할 때는 끄십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pozwól radiu LoRa nadawać. Wyłącz przy wymianie anteny na gorąco lub testach na stole."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permite que o rádio LoRa transmita. Desative ao trocar antenas com o rádio ligado ou durante testes de bancada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Разрешить радиомодулю LoRa передачу. Отключайте при замене антенн на включенном устройстве или при стендовых испытаниях."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Дозволити LoRa-радіостанції передавати. Вимикайте під час заміни антен на ввімкненому пристрої або стендового тестування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允许 LoRa 电台发射。热插拔天线或进行台架测试时请关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允許LoRa無線電發射。熱插拔天線或進行實驗台測試時請關閉。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用傳輸"
          }
        }
      }
    },
    "meshtastic.Config.LoRaConfig.use_preset.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Einstellungen der Modem-Voreinstellung statt manuell festgelegter Bandbreite, Spreizfaktor und Codierrate verwenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the modem preset settings instead of a manual bandwidth, spread factor and coding rate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa los ajustes del preajuste del módem en lugar de un ancho de banda, un factor de dispersión y una tasa de codificación manuales"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilise les réglages du préréglage du modem au lieu d’une largeur de bande, d’un facteur de diffusion et d’un taux de codage définis manuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa le impostazioni della preimpostazione del modem invece di larghezza di banda, fattore di diffusione e tasso di codifica manuali"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "帯域幅、拡散係数、符号化率を手動で設定する代わりに、モデムプリセットの設定を使用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "대역폭, 확산 계수, 코딩률을 직접 지정하는 대신 모뎀 프리셋 설정을 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Użyj ustawień presetu modemu zamiast ręcznie ustawionej szerokości pasma, spread factor i coding rate"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa as configurações do preset do modem em vez de definir manualmente a largura de banda, o fator de espalhamento e a taxa de codificação"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Использовать настройки пресета модема вместо ручного выбора пропускной способности, коэффициента распространения и скорости кодирования"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Використовувати налаштування пресета модема замість ручного вибору смуги пропускання, Spread Factor і швидкості кодування"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用调制解调器预设，而不是手动设置带宽、传播因子和编码率"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用數據機預設值的設定，而非手動設定頻寬、傳播因子和編碼速率"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用預設的調變參數"
          }
        }
      }
    },
