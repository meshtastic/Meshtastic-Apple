    "The mesh is too spread out to download terrain for all of it." : {
      "comment" : "Spatial map: the area around the mesh is over the per-map download limit",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Mesh ist zu weit verteilt, um Gelände für den gesamten Bereich herunterzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La malla está demasiado dispersa para descargar el terreno de toda su extensión."
          }
        },
        "fr" : {
          "stringUnit" : {
