    "meshtastic.Config.DeviceConfig.Role.LOST_AND_FOUND.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.Role.LOST_AND_FOUND",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sendet den Standort regelmäßig als Nachricht an den Standardkanal, um das Wiederfinden des Geräts zu erleichtern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Broadcasts location as message to default channel regularly to assist with device recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Difunde periódicamente la ubicación como mensaje en el canal predeterminado para ayudar a recuperar el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diffuse régulièrement la position sous forme de message sur le canal par défaut pour aider à retrouver l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trasmette regolarmente la posizione come messaggio sul canale predefinito per facilitare il recupero del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "デバイスを回収しやすくするため、位置をメッセージとしてデフォルトチャンネルに定期的にブロードキャストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "장치를 쉽게 되찾을 수 있도록 기본 채널에 위치를 메시지로 주기적으로 브로드캐스트합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regularnie wysyła lokalizację jako wiadomość na kanał domyślny, aby ułatwić odnalezienie urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Transmite a localização regularmente como mensagem no canal padrão para ajudar a recuperar o dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Регулярно транслирует местоположение сообщением в канал по умолчанию, чтобы помочь найти устройство."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Регулярно транслює місцезнаходження як повідомлення в типовий канал, щоб допомогти знайти пристрій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "定期将位置作为消息广播到默认频道，以帮助找回设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "定期將位置以訊息形式廣播至預設頻道，以協助尋回設備。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定期將位置以訊息形式廣播到預設頻道，以協助尋回裝置。"
          }
        }
      }
    },
