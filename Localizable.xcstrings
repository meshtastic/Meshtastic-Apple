    "meshtastic.Config.DeviceConfig.RebroadcastMode.LOCAL_ONLY.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.RebroadcastMode.LOCAL_ONLY",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignoriert beobachtete Nachrichten aus fremden Meshes, die offen sind oder nicht entschlüsselt werden können. Leitet nur Nachrichten auf den lokalen primären/sekundären Kanälen des Knotens weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ignores observed messages from foreign meshes that are open or those which it cannot decrypt. Only rebroadcasts messages on the node's local primary / secondary channels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora los mensajes observados de mallas externas que estén abiertas o que no pueda descifrar. Solo retransmite mensajes en los canales locales principal y secundarios del nodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignore les messages observés provenant de réseaux maillés étrangers ouverts ou qu’il ne peut pas déchiffrer. Ne rediffuse que les messages des canaux locaux principal et secondaires du nœud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora i messaggi osservati provenienti da mesh esterne aperte o che non riesce a decifrare. Ritrasmette i messaggi solo sui canali locali principale e secondari del nodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "公開されている外部メッシュや復号できない外部メッシュから受信したメッセージを無視します。ノードのローカルのプライマリ/セカンダリチャンネル上のメッセージのみを再ブロードキャストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "공개된 다른 메시나 복호화할 수 없는 다른 메시에서 수신한 메시지를 무시합니다. 노드의 로컬 기본/보조 채널의 메시지만 중계합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ignoruje wiadomości z obcych sieci, które są otwarte albo których nie może odszyfrować. Przekazuje tylko wiadomości z lokalnego kanału głównego i dodatkowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora mensagens observadas de meshes externas que estão abertas ou que o nó não consegue descriptografar. Só retransmite mensagens nos canais locais principal e secundários do nó."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Игнорирует сообщения из чужих сетей, которые открыты или которые нода не может расшифровать. Ретранслирует сообщения только на локальных первичном и вторичных каналах ноды."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ігнорує помічені повідомлення з чужих mesh-мереж, які відкриті або які неможливо розшифрувати. Ретранслює повідомлення лише на локальних основному та вторинних каналах вузла."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "忽略来自开放的外部 Mesh 网络或无法解密的消息。仅转发节点本地主要/次要频道上的消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "忽略從開放或無法解密的外部網格收到的訊息。僅轉發節點本地主要/次要頻道上的訊息。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略來自開放或無法解密之外部 Mesh 的訊息，僅轉發節點本地主要／次要頻道上的訊息。"
          }
        }
      }
    },
