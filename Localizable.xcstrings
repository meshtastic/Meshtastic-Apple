    "meshtastic.Config.DeviceConfig.disable_triple_click.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.disable_triple_click",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deaktiviert den Kurzbefehl durch dreifaches Drücken der Benutzertaste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disables the user button triple-press shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desactiva el atajo de triple pulsación del botón de usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Désactive le raccourci de triple appui sur le bouton utilisateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Disattiva la scorciatoia della tripla pressione del pulsante utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ユーザーボタンを3回押すショートカットを無効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "사용자 버튼을 세 번 누르는 단축 동작을 비활성화합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wyłącza skrót potrójnego naciśnięcia przycisku użytkownika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Desativa o atalho de pressionar três vezes o botão do usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отключает действие тройного нажатия пользовательской кнопки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вимикає дію потрійного натискання користувацької кнопки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
