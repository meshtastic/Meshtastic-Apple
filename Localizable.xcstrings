    "Use your phone GPS to send locations to your node to instead of using a hardware GPS on your node." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende das GPS deines Handys anstelle des GPS deines Funkgeräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice el GPS de su teléfono para enviar ubicaciones a su nodo en lugar de utilizar un GPS de hardware en su nodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez le GPS de votre téléphone pour envoyer des positions à votre nœud au lieu d'utiliser un GPS matériel sur votre nœud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilizza il GPS del tuo telefono per inviare le posizioni al tuo nodo invece di utilizzare un GPS hardware sul tuo nodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ノードのハードウェアGPSの代わりに、スマートフォンのGPSを使用してノードに位置を送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노드의 하드웨어 GPS 대신 휴대폰 GPS를 사용하여 위치 정보를 노드로 전송합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj GPS telefonu do wysyłania lokalizacji do węzła zamiast sprzętowego GPS w węźle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use o GPS do seu telefone para enviar localização para seu nó em vez de usar um GPS de hardware no seu nó."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте GPS вашего телефона для отправки местоположения на вашу ноду вместо использования аппаратного GPS на вашей ноде."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Користите GPS свог телефона да шаљете локације свом чвору уместо да користите хардверски GPS на самом чвору."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовувати GPS телефона для надсилання місцезнаходжень на вузол замість апаратного GPS на вузлі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用你的手机GPS发送位置到你的节点，而不是使用硬件GPS在你的节点上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用您的手機GPS來將位置發送到您的節點，而不是使用節點上的硬件GPS。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用手機 GPS 將位置傳送到您的節點，而不是使用節點上的硬體 GPS。"
          }
        }
      }
    },
    "Used for rooftop nodes to distribute messages more widely from multiple nearby client mute nodes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für Knoten auf Dächern, um Nachrichten von mehreren nahegelegenen Client-Mute-Knoten weiter zu verbreiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se usa en nodos de azotea para distribuir más ampliamente los mensajes de varios nodos cercanos en modo Cliente Silenciado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilisé pour les nœuds sur les toits afin de diffuser plus largement les messages de plusieurs nœuds Client Mute à proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usato per i nodi sui tetti, per diffondere più ampiamente i messaggi provenienti da più nodi Client Mute vicini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "屋上のノードで使用し、近くにある複数のクライアント（ミュート）ノードからのメッセージをより広範囲に配信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "옥상 노드에 사용하며, 근처에 있는 여러 Client Mute 노드의 메시지를 더 넓게 전달합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usado em nós no telhado para distribuir de forma mais ampla as mensagens de vários nós Client Mute próximos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Используется для нод на крышах, чтобы шире распространять сообщения от нескольких ближайших нод Client Mute."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Використовується для вузлів на дахах, щоб ширше поширювати повідомлення від кількох розташованих поблизу вузлів Client Mute."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "适用于屋顶节点，可将附近多个静音客户端节点的消息更广泛地分发出去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用於屋頂節點，將附近多個靜音客戶端節點的訊息更廣泛地轉發出去。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於屋頂節點，從多個附近的靜音客戶端節點更廣泛地分發訊息。"
          }
        }
      }
    },
