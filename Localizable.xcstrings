    "meshtastic.ModuleConfig.DetectionSensorConfig.state_broadcast_secs.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie oft der Zustand des Detektionssensors ans Mesh gesendet wird, unabhängig davon, ob etwas erkannt wurde. Bei 0 wird nur bei einer Detektion gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often to send the detection sensor state to the mesh, whether or not anything was detected. 0 sends only on detection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con qué frecuencia se envía el estado del sensor de detección a la malla, se haya detectado algo o no. Con 0 solo se envía al detectar algo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fréquence d’envoi de l’état du capteur de détection au réseau mesh, qu’une détection ait eu lieu ou non. Avec 0, l’envoi n’a lieu qu’en cas de détection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con quale frequenza inviare lo stato del sensore di rilevamento alla rete mesh, indipendentemente dal rilevamento. Con 0 l’invio avviene solo al rilevamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "検出の有無に関係なく、検出センサーの状態をメッシュに送信する頻度。0の場合は検出時のみ送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "감지 여부와 관계없이 감지 센서 상태를 메시로 전송하는 주기입니다. 0으로 설정하면 감지될 때만 전송합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak często wysyłać stan czujnika do sieci, niezależnie od tego, czy coś wykryto. 0 wysyła tylko przy wykryciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com que frequência o estado do sensor de detecção é enviado para a rede mesh, tenha ou não ocorrido alguma detecção. Com 0, só envia quando há detecção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Как часто отправлять состояние датчика обнаружения в сеть независимо от того, было ли что-то обнаружено. При значении 0 отправка происходит только при обнаружении."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Як часто надсилати стан датчика виявлення в mesh, незалежно від того, чи було щось виявлено. 0 — надсилати лише під час виявлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无论是否检测到任何情况，向网格发送检测传感器状态的频率。设为 0 时仅在检测到时发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無論是否偵測到任何狀況，將偵測感測器狀態傳送到網格的頻率。設為0時僅在偵測到時傳送。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無論是否偵測到變化，將偵測感測器狀態傳送到 Mesh 網路的頻率。設為 0 時僅在偵測到時傳送。"
          }
        }
      }
    },
