    "Changes this node's identity (private/public key) and admin keys — can break existing direct messages and lock local administration." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ändert die Identität dieses Knotens (privater/öffentlicher Schlüssel) und die Admin-Schlüssel – kann bestehende Direktnachrichten unterbrechen und die lokale Verwaltung sperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica la identidad de este nodo (clave privada/pública) y las claves de administrador — esto puede interrumpir los mensajes directos existentes y bloquear la administración local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifie l’identité de ce nœud (clé privée/publique) et les clés d’administration. Les messages directs existants peuvent cesser de fonctionner et l’administration locale peut être verrouillée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Modifica l’identità di questo nodo (chiave privata/pubblica) e le chiavi amministrative: può interrompere i messaggi diretti esistenti e bloccare l’amministrazione locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このノードのID（秘密鍵/公開鍵）と管理者キーを変更します。既存のダイレクトメッセージが使えなくなったり、ローカルでの管理がロックされたりする可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 노드의 ID(개인 키/공개 키)와 관리자 키를 변경합니다. 기존 개인 메시지가 작동하지 않거나 로컬 관리가 잠길 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zmienia tożsamość tego węzła (klucz prywatny i publiczny) i klucze administratora — może zepsuć istniejące wiadomości bezpośrednie i zablokować lokalne zarządzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Altera a identidade deste nó (chave privada/pública) e as chaves de administrador — pode interromper as mensagens diretas existentes e bloquear a administração local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Изменяет идентичность этой ноды (закрытый/открытый ключ) и ключи администратора — это может нарушить существующие личные сообщения и заблокировать локальное администрирование."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Змінює ідентичність цього вузла (приватний/відкритий ключ) і ключі адміністратора — це може порушити наявні прямі повідомлення та заблокувати локальне адміністрування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "更改此节点的身份（私钥/公钥）和管理员密钥，可能导致现有直接消息无法使用，并锁定本地管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "變更此節點的身分（私鑰/公鑰）和管理員金鑰，可能導致現有的直接訊息無法使用，並鎖定本機管理。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更此節點的身分（私鑰/公鑰）和管理金鑰 — 可能會中斷現有的私訊並鎖定本地管理。"
          }
        }
      }
    },
