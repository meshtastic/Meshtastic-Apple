    "meshtastic.ClientNotification.NotificationType.TRACEROUTE_BROADCAST_REJECTED.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.TRACEROUTE_BROADCAST_REJECTED",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Traceroute über mehrere Hops an die Broadcast-Adresse ist nicht erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
