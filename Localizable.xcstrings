        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "관리 모드에는 관리자 공개 키가 하나 이상 필요하므로 비활성화된 상태로 유지되었습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tryb zarządzany wymaga co najmniej jednego klucza publicznego administratora, więc pozostał wyłączony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O modo gerenciado precisa de pelo menos uma chave pública de administração, por isso continua desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для управляемого режима нужен хотя бы один открытый ключ администратора, поэтому режим остался выключенным."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Керований режим потребує щонайменше одного відкритого ключа адміністратора, тому його залишено вимкненим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
