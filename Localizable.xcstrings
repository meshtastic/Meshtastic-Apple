    "meshtastic.ModuleConfig.NeighborInfoConfig.enabled.description" : {
      "comment" : "description of meshtastic.ModuleConfig.NeighborInfoConfig.enabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aktiviere das Senden von Nachbarinformationen. Sendet regelmäßig Informationen über direkt empfangene Nachbarn, um die Mesh-Topologie sichtbar zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable neighbor info broadcasting. Periodically sends information about directly-heard neighbors to help visualize mesh topology."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Habilita la difusión de información sobre los vecinos. Envía periódicamente información sobre los vecinos detectados directamente para ayudar a visualizar la topología de la malla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Activez la diffusion des informations sur les voisins. Envoie régulièrement des informations sur les voisins entendus directement pour aider à visualiser la topologie du réseau maillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abilita la trasmissione delle informazioni sui vicini. Invia periodicamente informazioni sui vicini ricevuti direttamente per aiutare a visualizzare la topologia della mesh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "近隣ノード情報のブロードキャストを有効にします。直接受信した近隣ノードの情報を定期的に送信し、メッシュのトポロジーを可視化しやすくします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이웃 정보 브로드캐스트를 활성화합니다. Mesh 토폴로지 시각화를 위해 직접 수신한 이웃 노드 정보를 주기적으로 전송합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Włącz wysyłanie Info o sąsiadach. Okresowo wysyła informacje o bezpośrednio słyszanych sąsiadach, co pomaga zobrazować topologię sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ative a transmissão de informações de vizinhos. Envia periodicamente informações sobre os vizinhos ouvidos diretamente para ajudar a visualizar a topologia da mesh."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Включить трансляцию информации о соседях. Периодически отправляет сведения о напрямую слышимых соседях, помогая визуализировать топологию сети."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнути трансляцію інформації про сусідів. Періодично надсилає дані про безпосередньо почутих сусідів, щоб допомогти візуалізувати топологію mesh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "启用邻居信息广播。定期发送直接收听到的邻居节点信息，以帮助可视化 Mesh 网络拓扑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "啟用鄰居資訊廣播。定期傳送直接收到訊號的鄰居節點資訊，協助呈現網格拓撲。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用鄰居資訊廣播。定期傳送直接聽到的鄰居資訊，以協助視覺化網狀網路拓撲。"
          }
        }
      }
    },
