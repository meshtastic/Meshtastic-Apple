    "meshtastic.ModuleConfig.PaxcounterConfig.ble_threshold.description" : {
      "comment" : "description of meshtastic.ModuleConfig.PaxcounterConfig.ble_threshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RSSI-Schwellenwert für die Zählung von BLE-Geräten. Standard ist −80 dBm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "RSSI threshold for BLE device counting. Default is −80 dBm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Umbral de RSSI para contar dispositivos BLE. El valor predeterminado es −80 dBm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seuil RSSI pour le comptage des appareils BLE. La valeur par défaut est de −80 dBm."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Soglia RSSI per il conteggio dei dispositivi BLE. Il valore predefinito è −80 dBm."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "BLEデバイスのカウントに使用するRSSIしきい値。デフォルトは−80 dBmです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BLE 장치 수 집계에 사용할 RSSI 임계값입니다. 기본값은 −80 dBm입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Próg RSSI dla zliczania urządzeń BLE. Domyślnie −80 dBm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Limite de RSSI para a contagem de dispositivos BLE. O padrão é −80 dBm."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Порог RSSI для подсчета устройств BLE. По умолчанию −80 дБм."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поріг RSSI для підрахунку BLE-пристроїв. Типово — −80 дБм."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用于 BLE 设备计数的 RSSI 阈值。默认为 −80 dBm。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用於計算BLE設備數量的RSSI閾值。預設為−80 dBm。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BLE 裝置計數的 RSSI 閾值。預設為 −80 dBm。"
          }
        }
      }
    },
