    "meshtastic.ClientNotification.NotificationType.MQTT_PROXY_TO_CLIENT_REQUIRED.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.MQTT_PROXY_TO_CLIENT_REQUIRED",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Knoten ohne Netzwerkverbindung müssen den MQTT Client Proxy aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nodes without a network connection must enable MQTT proxy to client."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los nodos sin conexión de red deben activar el proxy de cliente MQTT."
