    "Local Mesh Discovery listens on each preset in turn and reports who it hears." : {
      "comment" : "Radio setup beacons page",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Lokale Mesh-Entdeckung“ hört nacheinander auf jeder Voreinstellung mit und zeigt an, wen sie empfängt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Descubrir mallas escucha cada preajuste por turnos e indica a quién escucha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« Découverte de réseau local » écoute chaque préréglage tour à tour et indique les nœuds qu’elle entend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Scoperta mesh locale” ascolta ogni preset a turno e riporta i nodi che riceve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“ローカルメッシュディスカバリー”は各プリセットで順番に受信し、受信できたノードを報告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "‘로컬 메시 탐색’은 각 프리셋에서 차례로 수신하며 수신된 노드를 보고합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykrywanie lokalnych sieci nasłuchuje po kolei na każdym presecie i pokazuje, kogo słyszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Descobrindo Rede Local” escuta cada preset, um de cada vez, e mostra quem ela ouve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Функция «Обнаружение локальных сетей» по очереди прослушивает каждый пресет и показывает, кого слышит."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Функція «Локальне виявлення mesh-мережі» по черзі прослуховує кожен пресет і показує, кого чує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“本地网格发现”会依次在每个预设上收听，并报告收听到的节点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「本地網格發現」會輪流在每個預設值上收聽，並回報收到訊號的節點。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地 Mesh 探索會輪流在每個預設上收聽，並回報收聽到的節點。"
          }
        }
      }
    },
