    "Adding a contact saves their name and public key to your connected node so you can message them securely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Hinzufügen eines Kontakts werden Name und öffentlicher Schlüssel auf deinem verbundenen Knoten gespeichert, damit du ihm sicher Nachrichten senden kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al agregar un contacto, su nombre y clave pública se guardan en el nodo conectado para que puedas enviarle mensajes de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’ajout d’un contact enregistre son nom et sa clé publique sur votre nœud connecté afin que vous puissiez lui envoyer des messages de manière sécurisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’aggiunta di un contatto salva il suo nome e la sua chiave pubblica nel nodo collegato, così puoi inviargli messaggi in modo sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "連絡先を追加すると、相手の名前と公開鍵が接続中のノードに保存され、安全にメッセージを送信できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처를 추가하면 해당 이름과 공개 키가 연결된 노드에 저장되어 안전하게 메시지를 보낼 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodanie kontaktu zapisuje jego nazwę i klucz publiczny w połączonym węźle, aby można było bezpiecznie wysyłać mu wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ao adicionar um contato, o nome e a chave pública dele são salvos no seu nó conectado para que você possa enviar mensagens com segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "При добавлении контакта его имя и открытый ключ сохраняются на подключенной ноде, чтобы можно было безопасно отправлять ему сообщения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додавання контакту зберігає його ім’я та відкритий ключ на підключеному вузлі, щоб ви могли безпечно надсилати йому повідомлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "添加联系人会将其名称和公钥保存到您已连接的节点，以便您安全地向其发送消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "新增聯絡人會將對方的名稱和公鑰儲存到您已連線的節點，讓您可以安全地傳送訊息給對方。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增聯絡人會將其名稱和公鑰儲存到您已連線的節點，以便您可以安全地傳送訊息給他們。"
          }
        }
      }
    },
