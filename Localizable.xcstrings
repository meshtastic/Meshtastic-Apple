    "No acknowledgment was received in time. Try again when you have better signal or more mesh coverage." : {
      "comment" : "RoutingError.description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Es wurde nicht rechtzeitig eine Bestätigung empfangen. Versuche es erneut, wenn du besseren Empfang oder mehr Mesh-Abdeckung hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se ha recibido confirmación a tiempo. Inténtelo de nuevo cuando tenga mejor señal o más cobertura de la malla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun accusé de réception n’a été reçu à temps. Réessayez lorsque vous aurez un meilleur signal ou une meilleure couverture du réseau mesh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nessuna conferma ricevuta in tempo. Riprova quando il segnale è migliore o la copertura della mesh è maggiore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "時間内に確認応答を受信できませんでした。電波状況が良くなるか、メッシュの通信範囲が広がったときにやり直してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "제시간에 수신 확인을 받지 못했습니다. 신호가 더 좋거나 메시 커버리지가 더 넓은 곳에서 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nenhuma confirmação foi recebida a tempo. Tente novamente quando tiver um sinal melhor ou mais cobertura da mesh."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Подтверждение не получено вовремя. Повторите попытку, когда сигнал станет лучше или покрытие сети шире."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Підтвердження не отримано вчасно. Спробуйте ще раз, коли сигнал буде кращим або покриття mesh-мережі ширшим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "未及时收到确认。请在信号更好或 Mesh 覆盖范围更广时重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "未及時收到確認。請在訊號較佳或網格涵蓋範圍較廣時再試一次。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未及時收到確認。請在訊號更好或 Mesh 涵蓋範圍更廣時重試。"
          }
        }
      }
    },
