    "Product links may be affiliate links — purchases may earn Meshtastic a commission." : {
      "comment" : "Affiliate disclosure shown above msh.to product links",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Produktlinks können Affiliate-Links sein — für Käufe kann Meshtastic eine Provision erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces a productos pueden ser enlaces de afiliado — las compras pueden generar una comisión para Meshtastic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les liens vers les produits peuvent être des liens d’affiliation — vos achats peuvent rapporter une commission à Meshtastic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I link ai prodotti potrebbero essere link di affiliazione: gli acquisti potrebbero far guadagnare una commissione a Meshtastic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "製品リンクはアフィリエイトリンクの場合があります。購入によりMeshtasticが手数料を受け取ることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "제품 링크는 제휴 링크일 수 있으며, 구매 시 Meshtastic이 수수료를 받을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
