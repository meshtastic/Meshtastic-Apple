    "Same as behavior as ALL but skips packet decoding and simply rebroadcasts them. Only available in Repeater role. Setting this on any other roles will result in ALL behavior." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie „Alle“, überspringt aber die Dekodierung der Pakete und leitet sie einfach weiter. Nur in der Rolle Repeater verfügbar. In jeder anderen Rolle führt diese Einstellung zum Verhalten von „Alle“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Igual que “Todos”, pero omite la decodificación de los paquetes y simplemente los retransmite. Solo disponible en el rol Repeater. En cualquier otro rol, este ajuste se comportará como “Todos”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Identique à « Tous », mais ignore le décodage des paquets et se contente de les retransmettre. Disponible uniquement avec le rôle Repeater. Avec tout autre rôle, ce réglage se comporte comme « Tous »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Come “Tutti”, ma salta la decodifica dei pacchetti e si limita a ritrasmetterli. Disponibile solo nel ruolo Repeater. Se impostata in qualsiasi altro ruolo, si comporta come “Tutti”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“すべて”と同じ動作ですが、パケットのデコードを省略してそのまま再ブロードキャストします。Repeaterの役割でのみ使用できます。ほかの役割で設定すると、“すべて”と同じ動作になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "‘전체’와 동일하게 작동하지만 패킷 디코딩을 건너뛰고 그대로 중계합니다. Repeater 역할에서만 사용할 수 있습니다. 다른 역할에서 설정하면 ‘전체’로 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Igual a “Todos”, mas pula a decodificação dos pacotes e simplesmente os retransmite. Disponível apenas no papel Repeater. Em qualquer outro papel, esta opção funciona como “Todos”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "То же, что «Все», но без декодирования пакетов — они просто ретранслируются. Доступно только в роли Repeater. В любой другой роли этот параметр работает как «Все»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Так само, як «Усі», але пропускає декодування пакетів і просто ретранслює їх. Доступно лише в ролі Repeater. У будь-якій іншій ролі це налаштування працюватиме як «Усі»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "与“全部”相同，但跳过数据包解码，直接转发。仅适用于 Repeater 角色。在其他任何角色上设置此项，都将按“全部”运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "與「全部」行為相同，但略過封包解碼，直接轉發。僅適用於Repeater角色。在其他任何角色上設定此項，都會依「全部」運作。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與「全部」行為相同，但略過封包解碼直接轉發。僅適用於中繼器角色。在其他角色上設定此項將導致「全部」行為。"
          }
        }
      }
    },
