    "meshtastic.ClientNotification.NotificationType.SERIAL_CONSOLE_OVERRIDE_INVALID.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.SERIAL_CONSOLE_OVERRIDE_INVALID",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das Übersteuern des seriellen Konsolenports wird nur in den Ausgabemodi NMEA, CalTopo oder MS Config unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Overriding the console serial port is only supported in NMEA, CalTopo, or MS Config output modes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anular el puerto serie de la consola solo se admite en los modos de salida NMEA, CalTopo o MS Config."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le remplacement du port série de la console n’est pris en charge que dans les modes de sortie NMEA, CalTopo ou MS Config."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’override della porta seriale della console è supportato solo nelle modalità di uscita NMEA, CalTopo o MS Config."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
