    "Add \"%@\" as an additional channel — your radio keeps its current mesh, no reboot." : {
      "comment" : "A confirmation dialog message that appears when the user is prompted to add a new channel.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ als zusätzlichen Kanal hinzufügen – dein Funkgerät behält sein aktuelles Mesh, kein Neustart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue \"%@\" como un canal adicional. Su radio mantiene su malla actual, sin reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoutez « %@ » comme canal supplémentaire : votre radio conserve son réseau maillé actuel, sans redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiungi “%@” come canale aggiuntivo: la radio mantiene la mesh attuale, senza riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「%@」を追加チャンネルとして追加します。無線機は現在のメッシュを維持し、再起動は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” 채널을 추가 채널로 추가합니다. 노드는 현재 메시를 유지하며 재부팅되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adicionar “%@” como canal adicional — seu rádio mantém a mesh atual, sem reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавить «%@» как дополнительный канал — радиостанция останется в текущей сети, без перезагрузки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Додати «%@» як додатковий канал — радіостанція залишиться у поточній mesh-мережі, без перезапуску."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将“%@”添加为额外频道。您的电台将保留当前的 Mesh，无需重启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將「%@」新增為額外頻道，無線電會保留目前的網格，無需重新開機。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
