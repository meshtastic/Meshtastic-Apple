    "This radio uses a newer region that this app does not support. Choose a supported region before saving." : {
      "comment" : "A warning that a region is not supported by the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
