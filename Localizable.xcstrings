    "Relays are numbered in order, filled orange on the way out and outlined blue on the way back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Relay-Knoten sind der Reihe nach nummeriert: auf dem Hinweg orange gefüllt, auf dem Rückweg blau umrandet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los nodos de retransmisión se numeran en orden: rellenos en naranja a la ida y con contorno azul a la vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les relais sont numérotés dans l’ordre : remplis en orange à l’aller et entourés de bleu au retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I nodi intermedi sono numerati in ordine: pieni in arancione all’andata e con contorno blu al ritorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "中継ノードには順番に番号が付き、往路ではオレンジの塗りつぶし、復路では青の輪郭で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "중계 노드에는 순서대로 번호가 매겨지며, 가는 경로에서는 주황색으로 채워지고 돌아오는 경로에서는 파란색 테두리로 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekaźniki są ponumerowane po kolei: wypełnione na pomarańczowo w drodze do celu, z niebieskim obrysem w drodze powrotnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os nós retransmissores são numerados em ordem: preenchidos em laranja na ida e com contorno azul na volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ретрансляторы пронумерованы по порядку: на пути туда они залиты оранжевым, на обратном пути — обведены синим."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ретранслятори пронумеровано по черзі: на шляху туди вони залиті помаранчевим, на шляху назад — обведені синім."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "中继节点按顺序编号，去程以橙色实心标示，回程以蓝色描边标示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "中繼節點依序編號，去程以橘色實心標示，回程以藍色外框標示。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中繼節點依序編號，去程以橘色實心標示，回程以藍色外框標示。"
          }
        }
      }
    },
