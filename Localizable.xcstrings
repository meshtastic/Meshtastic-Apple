    "meshtastic.ClientNotification.NotificationType.CHANNEL_NAME_WONT_AUTO_RESOLVE.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.CHANNEL_NAME_WONT_AUTO_RESOLVE",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Kanalname entspricht der neuen Modem-Voreinstellung, wird aber nicht automatisch aktualisiert. Lösche den Namen, um das zu beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A channel name matches the new modem preset but won't update automatically. Clear the name to fix it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un nombre de canal coincide con el nuevo preajuste de módem, pero no se actualizará automáticamente. Borra el nombre para solucionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le nom d’un canal correspond au nouveau préréglage de modem, mais ne sera pas mis à jour automatiquement. Effacez le nom pour corriger le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il nome di un canale corrisponde alla nuova preimpostazione del modem, ma non verrà aggiornato automaticamente. Cancella il nome per risolvere il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "チャンネル名が新しいモデムプリセットと一致していますが、自動的には更新されません。修正するには名前を消去してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "채널 이름이 새 모뎀 프리셋과 일치하지만 자동으로 업데이트되지 않습니다. 이름을 지워 문제를 해결하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
