    "Only answer requestors within this many hops." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beantwortet nur Anfragen von Knoten innerhalb dieser Anzahl an Hops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda únicamente a los solicitantes que se encuentren dentro de este número de saltos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Répond uniquement aux demandeurs situés à ce nombre de sauts au maximum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Risponde solo ai richiedenti entro questo numero di hop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このホップ数以内の要求元にのみ応答します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 홉 수 이내의 요청자에게만 응답합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Responde apenas a solicitantes dentro deste número de saltos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отвечать только тем, кто запрашивает в пределах этого количества хопов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відповідати лише тим, хто надсилає запит у межах цієї кількості хопів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅回应此跳数以内的请求者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "僅回應此跳數以內的請求者。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅回應在此跳數內的請求者。"
          }
        }
      }
    },
    "Only show and process cryptographically authenticated mesh packets. Older nodes and oversized packets may disappear." : {
      "comment" : "Description of the Strict packet authenticity policy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nur kryptografisch authentifizierte Mesh-Pakete werden angezeigt und verarbeitet. Ältere Knoten und übergroße Pakete können verschwinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se mostrarán y procesarán los paquetes de malla autenticados criptográficamente. Los nodos más antiguos y los paquetes de gran tamaño podrían desaparecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seuls les paquets du réseau maillé authentifiés de manière cryptographique sont affichés et traités. Les nœuds anciens et les paquets trop volumineux peuvent disparaître."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra ed elabora solo i pacchetti della mesh autenticati crittograficamente. I nodi meno recenti e i pacchetti troppo grandi potrebbero scomparire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "暗号によって認証されたメッシュパケットのみを表示および処理します。古いノードやサイズが大きすぎるパケットは表示されなくなる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호학적으로 인증된 메시 패킷만 표시하고 처리합니다. 오래된 노드와 크기가 큰 패킷은 표시되지 않을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra e processa apenas pacotes da mesh autenticados criptograficamente. Nós mais antigos e pacotes grandes demais podem sumir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывать и обрабатывать только криптографически аутентифицированные пакеты сети. Старые ноды и слишком большие пакеты могут пропасть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показувати й обробляти лише криптографічно автентифіковані пакети mesh-мережі. Старіші вузли та завеликі пакети можуть зникнути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅显示和处理经过加密验证的 Mesh 数据包。较旧的节点和超大数据包可能会消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "僅顯示與處理經加密驗證的網格封包。較舊的節點和過大的封包可能會消失。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅顯示和處理密碼驗證的 Mesh 封包。較舊的節點和超大封包可能會消失。"
          }
        }
      }
    },
