    "Line mode sends a whole command at once, which is lighter on a busy mesh." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Zeilenmodus sendet einen ganzen Befehl auf einmal und belastet ein ausgelastetes Mesh weniger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El modo de línea envía el comando completo de una vez, lo que supone menos carga para una malla saturada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le mode ligne envoie une commande entière en une seule fois, ce qui allège la charge sur un réseau maillé encombré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La modalità riga invia un intero comando in una sola volta, alleggerendo il carico su una mesh trafficata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "行モードではコマンド全体を一度に送信するため、混雑したメッシュへの負荷が軽くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "줄 단위 모드는 명령 전체를 한 번에 보내므로 혼잡한 메시에 부담이 적습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb linii wysyła całe polecenie naraz, co mniej obciąża zajętą sieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O modo de linha envia o comando inteiro de uma vez, o que pesa menos em uma mesh movimentada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Построчный режим отправляет всю команду сразу, что меньше нагружает сеть при высоком трафике."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Порядковий режим надсилає всю команду одразу, що менше навантажує завантажену mesh-мережу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "整行模式会一次发送整条命令，可减轻繁忙 Mesh 网络的负担。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "整行模式會一次傳送整個指令，可減輕繁忙網格的負擔。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整行模式會一次傳送整個指令，可減輕繁忙 Mesh 的負擔。"
          }
        }
      }
    },
