    "meshtastic.Config.SecurityConfig.PacketSignaturePolicy.PACKET_SIGNATURE_POLICY_COMPATIBLE.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unsignierter Datenverkehr wird für maximale Kompatibilität akzeptiert. Eine prüfbare, aber falsche Signatur verwirft das Paket trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accept unsigned traffic for maximum compatibility. A signature that can be checked and is wrong still drops the packet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Acepta tráfico sin firmar para lograr la máxima compatibilidad. Si una firma se puede comprobar y es incorrecta, el paquete se descarta igualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accepte le trafic non signé pour une compatibilité maximale. Un paquet dont la signature peut être vérifiée mais s’avère incorrecte est tout de même ignoré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Accetta il traffico non firmato per la massima compatibilità. Un pacchetto con una firma verificabile ma errata viene comunque scartato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "互換性を最大限に保つため、署名のないトラフィックを受け入れます。検証可能な署名が正しくない場合、そのパケットは引き続き破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "최대 호환성을 위해 서명되지 않은 트래픽을 허용합니다. 검증할 수 있는 서명이 올바르지 않으면 해당 패킷은 여전히 버려집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Akceptuj niepodpisany ruch dla maksymalnej zgodności. Podpis, który da się sprawdzić i jest błędny, nadal odrzuca pakiet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aceita tráfego não assinado para máxima compatibilidade. Uma assinatura que pode ser verificada e está incorreta ainda faz o pacote ser descartado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Принимать неподписанный трафик для максимальной совместимости. Пакет, подпись которого можно проверить и она неверна, все равно отбрасывается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Приймає непідписаний трафік для максимальної сумісності. Якщо підпис можна перевірити і він неправильний, пакет однаково відкидається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "接受未签名的流量以实现最大兼容性。如果签名可以校验但不正确，数据包仍会被丢弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "為了最大相容性，接受未簽署的流量。若簽署可供檢查但不正確，仍會捨棄該封包。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受已簽署和未簽署的封包"
          }
        }
      }
    },
