    "meshtastic.ClientNotification.NotificationType.ROUTER_REBROADCAST_NONE_REJECTED.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.ROUTER_REBROADCAST_NONE_REJECTED",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für eine Router-Rolle kann der Übertragungsmodus nicht NONE sein, daher wurde er auf ALL gesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rebroadcast mode can't be NONE for a router role, so it was set to ALL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El modo de retransmisión no puede ser NONE con el rol de router, por lo que se ha establecido en ALL."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le mode de diffusion ne peut pas être NONE avec le rôle Router ; il a donc été défini sur ALL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con il ruolo router la modalità di ritrasmissione non può essere NONE, quindi è stata impostata su ALL."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Routerの役割では再ブロードキャストモードをNONEにできないため、ALLに設定されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
