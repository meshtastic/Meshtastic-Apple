        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывает сохраненные карты поверх покрытых областей. Они также появляются автоматически, когда у iOS нет сетевого маршрута."
          }
        },
        "uk" : {
