    "Add keeps the recipient's LoRa settings and adds the selected channels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„Hinzufügen“ behält die LoRa-Einstellungen des Empfängers und fügt die ausgewählten Kanäle hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregar conserva la configuración LoRa del receptor y añade los canales seleccionados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "« Ajouter » conserve les réglages LoRa du destinataire et ajoute les canaux sélectionnés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aggiungi mantiene le impostazioni LoRa del destinatario e aggiunge i canali selezionati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「追加」を選ぶと、受信者のLoRa設定はそのままで、選択したチャンネルが追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "‘추가’는 수신자의 LoRa 설정을 유지하고 선택한 채널을 추가합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Dodaj” zachowuje ustawienia LoRa odbiorcy i dodaje wybrane kanały."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Adicionar” mantém as configurações LoRa do destinatário e adiciona os canais selecionados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Добавить» сохраняет настройки LoRa получателя и добавляет выбранные каналы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«Додати» зберігає налаштування LoRa отримувача й додає вибрані канали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“添加”会保留接收者的 LoRa 设置，并添加所选频道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
