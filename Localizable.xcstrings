    "Download a map with terrain for the 3D map to hang the sky deck on a real tower." : {
      "comment" : "Cinema sky deck: shown on the panel when no terrain has been downloaded",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lade eine Karte mit Gelände für die 3D-Karte herunter, um die Aussichtsplattform an einem echten Turm aufzuhängen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Descarga un mapa con terreno para que el mapa 3D coloque el mirador en una torre real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Téléchargez une carte avec relief pour que la carte 3D place la plateforme panoramique sur une vraie tour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scarica una mappa con il terreno per permettere alla mappa 3D di collocare la terrazza panoramica su una torre reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "3Dマップでスカイデッキを実在のタワーに配置するには、地形を含むマップをダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "3D 지도에서 스카이 덱을 실제 타워에 배치하려면 지형이 포함된 지도를 다운로드하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Baixe um mapa com terreno para que o mapa 3D coloque o mirante em uma torre real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Загрузите карту с рельефом для 3D-карты, чтобы разместить смотровую площадку на реальной башне."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Завантажте мапу з рельєфом для 3D-мапи, щоб розмістити оглядовий майданчик на справжній вежі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请下载含地形的地图，以便 3D 地图将空中观景台安放在真实的高塔上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請下載含地形的地圖，讓3D地圖將空中觀景台安置在真實的高塔上。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
