    "meshtastic.Config.SecurityConfig.public_key.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wird aus deinem privaten Schlüssel generiert und an andere Knoten im Mesh gesendet, damit sie einen gemeinsamen Geheimschlüssel berechnen können"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generated from your private key and sent out to other nodes on the mesh to allow them to compute a shared secret key"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se genera a partir de tu clave privada y se envía a otros nodos de la malla para que puedan calcular una clave secreta compartida"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Générée à partir de votre clé privée et envoyée aux autres nœuds du réseau afin qu’ils puissent calculer une clé secrète partagée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Generata dalla chiave privata e inviata agli altri nodi del mesh per consentire loro di calcolare una chiave segreta condivisa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "秘密鍵から生成されてメッシュ上のほかのノードに送信され、ほかのノードが共有秘密鍵を計算できるようにします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "개인 키에서 생성되며, 메시의 다른 노드에 전송되어 공유 비밀 키를 계산할 수 있도록 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Generowany z klucza prywatnego i wysyłany do innych węzłów w sieci, aby mogły obliczyć wspólny tajny klucz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gerada a partir da sua chave privada e enviada para outros nós da rede para que eles possam calcular uma chave secreta compartilhada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Генерируется на основе закрытого ключа и отправляется другим нодам сети, чтобы они могли вычислить общий секретный ключ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Генерується з приватного ключа та надсилається іншим вузлам у mesh, щоб вони могли обчислити спільний секретний ключ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "由你的私钥生成，并发送给 Mesh 上的其他节点，以便它们计算共享密钥"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "由私鑰產生，並傳送給網格上的其他節點，讓它們能計算共享密鑰"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於加密的公鑰"
          }
        }
      }
    },
