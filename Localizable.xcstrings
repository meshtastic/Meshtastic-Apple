    "Hold a writable NFC tag near the top of your iPhone to save these channel settings to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Halte einen beschreibbaren NFC-Tag an die Oberseite deines iPhone, um diese Kanaleinstellungen darauf zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca una etiqueta NFC grabable a la parte superior de tu iPhone para guardar estos ajustes de canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Approchez un tag NFC inscriptible du haut de votre iPhone pour y enregistrer ces paramètres de canal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avvicina un tag NFC scrivibile alla parte superiore di iPhone per salvarvi queste impostazioni del canale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "書き込み可能なNFCタグをiPhoneの上部に近づけると、このチャンネル設定をタグに保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쓰기 가능한 NFC 태그를 iPhone 상단에 가까이 대어 이 채널 설정을 저장하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przyłóż zapisywalny tag NFC do górnej części iPhone'a, aby zapisać na nim te ustawienia kanałów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aproxime uma etiqueta NFC gravável da parte superior do iPhone para salvar nela estas configurações de canal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Поднесите записываемую NFC-метку к верхней части iPhone, чтобы сохранить на нее эти настройки канала."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Піднесіть записувану NFC-мітку до верхньої частини iPhone, щоб зберегти на неї ці налаштування каналу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将可写入的 NFC 标签靠近 iPhone 顶部，以将这些频道设置保存到标签中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將可寫入的NFC標籤靠近iPhone頂部，即可將這些頻道設定儲存到標籤中。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將可寫入的 NFC 標籤放在 iPhone 頂部附近以儲存這些頻道設定。"
          }
        }
      }
    },
    "Hold a writable NFC tag near the top of your iPhone to save your contact to it." : {
