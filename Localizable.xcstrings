        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此设备上的更新加载程序不支持此连接方式。通过 USB 使用 Web Flasher 进行完整安装即可替换它。"
          }
        },
        "zh-Hant" : {
