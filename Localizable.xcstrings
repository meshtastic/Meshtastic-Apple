    "meshtastic.Config.PowerConfig.on_battery_shutdown_after_secs.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie lange das Gerät nach dem Trennen der externen Stromversorgung wartet, bevor es sich ausschaltet. 0 zum Deaktivieren; Werte unter 30 Sekunden werden auf 30 angehoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long after external power is removed before the device powers off. Zero to disable; values under 30 seconds are raised to 30."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuánto tiempo pasa desde que se retira la alimentación externa hasta que el dispositivo se apaga. 0 para desactivar; los valores inferiores a 30 segundos se elevan a 30."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Délai entre la coupure de l’alimentation externe et l’extinction de l’appareil. 0 pour désactiver ; les valeurs inférieures à 30 secondes sont portées à 30."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dopo quanto tempo dalla rimozione dell’alimentazione esterna il dispositivo si spegne. 0 per disattivare; i valori inferiori a 30 secondi vengono portati a 30."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "外部電源が外れてからデバイスの電源が切れるまでの時間。0にすると無効になります。30秒未満の値は30秒に引き上げられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "외부 전원이 차단된 후 장치가 꺼질 때까지의 시간입니다. 0으로 설정하면 비활성화되며, 30초 미만의 값은 30초로 올려 적용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po jakim czasie od odłączenia zasilania zewnętrznego urządzenie się wyłącza. Zero wyłącza tę funkcję; wartości poniżej 30 sekund są podnoszone do 30."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanto tempo após a remoção da alimentação externa o dispositivo leva para desligar. Use 0 para desativar; valores abaixo de 30 segundos são elevados para 30."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Через какое время после отключения внешнего питания устройство выключится. 0 — не выключать; значения меньше 30 секунд увеличиваются до 30."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Через який час після відключення зовнішнього живлення пристрій вимкнеться. 0 — вимкнути; значення менше 30 секунд підвищуються до 30."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "移除外部电源后，设备等待多久再关机。设为 0 可停用；低于 30 秒的值将提高为 30 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "移除外部電源後，設備經過多久關機。設為0可停用；低於30秒的值會提高為30秒。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除外部電源後，裝置經過多久關機。設為 0 可停用；低於 30 秒的值會提高為 30 秒。"
          }
        }
      }
    },
