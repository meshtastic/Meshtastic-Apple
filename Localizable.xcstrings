    "meshtastic.ModuleConfig.TrafficManagementConfig.nodeinfo_direct_response_max_hops.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beantwortet NodeInfo-Anfragen aus dem Cache für anfragende Knoten innerhalb dieser Anzahl an Hops. Auf Routern auf 3 begrenzt; andere Rollen antworten nur direkten Nachbarn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer NodeInfo requests from cache for requestors within this many hops. Capped at 3 on routers; other roles answer direct neighbors only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Responde desde la caché a las solicitudes de NodeInfo de los solicitantes que estén dentro de este número de saltos. Limitado a 3 en routers; los demás roles solo responden a vecinos directos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Répond depuis le cache aux requêtes NodeInfo des demandeurs situés à ce nombre de sauts au maximum. Limité à 3 sur les routeurs ; les autres rôles ne répondent qu’aux voisins directs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Risponde dalla cache alle richieste NodeInfo dei richiedenti entro questo numero di hop. Limitato a 3 sui router; gli altri ruoli rispondono solo ai vicini diretti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このホップ数以内の要求元からのNodeInfo要求に、キャッシュから応答します。Routerでは最大3に制限され、ほかの役割では直接の近隣ノードにのみ応答します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 홉 수 이내의 요청자에게는 캐시에서 NodeInfo 요청에 응답합니다. Router 역할에서는 최대 3으로 제한되며, 다른 역할은 직접 이웃에게만 응답합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odpowiadaj z pamięci podręcznej na żądania NodeInfo od węzłów oddalonych o najwyżej tyle skoków. Na routerach maksymalnie 3; inne role odpowiadają tylko bezpośrednim sąsiadom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Responde a solicitações de NodeInfo a partir do cache para solicitantes dentro deste número de saltos. Limitado a 3 em routers; os outros papéis respondem apenas a vizinhos diretos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отвечать на запросы NodeInfo из кэша тем, кто запрашивает в пределах этого количества хопов. На роутерах не более 3; остальные роли отвечают только прямым соседям."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відповідати на запити NodeInfo з кешу тим, хто надсилає запит у межах цієї кількості хопів. На вузлах Router — не більше 3; інші ролі відповідають лише прямим сусідам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "对于此跳数以内的请求者，直接从缓存回应 NodeInfo 请求。Router 角色最多 3 跳；其他角色仅回应直接邻居。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "對此跳數以內的請求者，直接以快取回應NodeInfo請求。Router角色最多3跳；其他角色僅回應直接相鄰的節點。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於在此跳點數以內的請求者，直接以快取回應 NodeInfo 請求。路由器最多 3 跳；其他角色只回應直接相鄰的節點。"
          }
        }
      }
    },
    "meshtastic.ModuleConfig.TrafficManagementConfig.position_min_interval_secs.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
