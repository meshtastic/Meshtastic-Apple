    "This could take a while, response will appear in the trace route log for the node it was sent to." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dette kan tage et stykke tid. Svaret vil vises i rutesporingsloggen (trace route) for den node, det blev sendt til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das könnte eine Weile dauern, die Antwort wird im Trace-Route-Log des Knotens erscheinen, an dem sie gesendet wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto podría tardar un tiempo, la respuesta aparecerá en el registro de rastreo de ruta del nodo al que se envió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
