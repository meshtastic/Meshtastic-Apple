          }
        }
      }
    },
    "Bluetooth radio %@\nPIN %@\n\nThe PIN is copied when you connect. Choose the radio on Connect, then paste the PIN when iOS asks to pair." : {
      "comment" : "Connect link prompt for a Bluetooth radio with a pairing PIN; the first value is its Bluetooth address",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth-Funkgerät %@\nPIN %@\n\nDie PIN wird beim Verbinden kopiert. Wähle das Funkgerät unter „Verbinden“ aus und füge die PIN ein, wenn iOS nach der Kopplung fragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Radio Bluetooth %@\nPIN %@\n\nEl PIN se copia al conectarte. Elige la radio en Conectar y pega el PIN cuando iOS solicite el enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Radio Bluetooth %@\nCode PIN %@\n\nLe code PIN est copié lors de la connexion. Choisissez la radio dans l’écran de connexion, puis collez le code PIN lorsqu’iOS demande le jumelage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Radio Bluetooth %@\nPIN %@\n\nIl PIN viene copiato quando ti connetti. Scegli la radio in Connetti, poi incolla il PIN quando iOS richiede l’abbinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth無線機 %@\nPIN %@\n\n接続時にPINがコピーされます。「接続」でこの無線機を選択し、iOSからペアリングを求められたらPINをペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bluetooth 장치 %@\nPIN %@\n\n연결하면 PIN이 복사됩니다. ‘연결’에서 장치를 선택한 다음, iOS에서 페어링을 요청하면 PIN을 붙여넣으십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rádio Bluetooth %@\nPIN %@\n\nO PIN é copiado quando você se conecta. Escolha o rádio na tela “Conectar” e cole o PIN quando o iOS pedir para emparelhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
