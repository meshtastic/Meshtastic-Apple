    "meshtastic.ModuleConfig.SerialConfig.timeout.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie lange gewartet wird, bevor empfangene serielle Daten als vollständiges Paket gelten. Bei 0 werden 250 ms verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long to wait before treating received serial data as a complete packet. 0 uses 250 ms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuánto tiempo se espera antes de tratar los datos serie recibidos como un paquete completo. Con 0 se usan 250 ms."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durée d’attente avant de traiter les données série reçues comme un paquet complet. Avec 0, 250 ms sont utilisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tempo di attesa prima di considerare i dati seriali ricevuti come un pacchetto completo. Con 0 vengono usati 250 ms."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "受信したシリアルデータを完全なパケットとして扱うまでの待機時間です。0の場合は250 msを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "수신한 시리얼 데이터를 완전한 패킷으로 처리하기 전에 기다리는 시간입니다. 0으로 설정하면 250ms를 사용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak długo czekać, zanim odebrane dane szeregowe zostaną uznane za pełny pakiet. 0 oznacza 250 ms."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quanto tempo esperar antes de tratar os dados seriais recebidos como um pacote completo. Com 0, usa 250 ms."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сколько ждать, прежде чем считать полученные через последовательный порт данные целым пакетом. При 0 используется 250 мс."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Скільки чекати, перш ніж вважати отримані через Serial дані цілим пакетом. Якщо 0, використовується 250 мс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将收到的串口数据视为完整数据包前的等待时长。设为 0 时使用 250 毫秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "將收到的串口資料視為完整封包前的等待時間。設為0時使用250毫秒。"
