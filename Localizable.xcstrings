    "Only permitted for SENSOR, TRACKER and TAK_TRACKER roles, this will inhibit all rebroadcasts, not unlike CLIENT_MUTE role." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nur für die Rollen SENSOR, TRACKER und TAK_TRACKER zulässig. Unterdrückt alle Weiterleitungen, ähnlich wie die Rolle CLIENT_MUTE."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solo se permite para los roles SENSOR, TRACKER y TAK_TRACKER. Impide todas las retransmisiones, de forma similar al rol CLIENT_MUTE."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorisé uniquement pour les rôles SENSOR, TRACKER et TAK_TRACKER. Empêche toutes les retransmissions, comme le rôle CLIENT_MUTE."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Consentito solo per i ruoli SENSOR, TRACKER e TAK_TRACKER. Impedisce tutte le ritrasmissioni, in modo simile al ruolo CLIENT_MUTE."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SENSOR、TRACKER、およびTAK_TRACKERの役割でのみ使用できます。CLIENT_MUTEの役割と同様に、すべての再ブロードキャストを停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SENSOR, TRACKER 및 TAK_TRACKER 역할에서만 허용됩니다. CLIENT_MUTE 역할과 마찬가지로 모든 중계를 차단합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permitido apenas para os papéis SENSOR, TRACKER e TAK_TRACKER. Impede todas as retransmissões, de forma parecida com o papel CLIENT_MUTE."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Разрешено только для ролей SENSOR, TRACKER и TAK_TRACKER. Блокирует все ретрансляции, подобно роли CLIENT_MUTE."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Дозволено лише для ролей SENSOR, TRACKER і TAK_TRACKER. Блокує всі ретрансляції, подібно до ролі CLIENT_MUTE."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅允许 SENSOR、TRACKER 和 TAK_TRACKER 角色使用。此设置将禁止所有转发，类似于 CLIENT_MUTE 角色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "僅允許SENSOR、TRACKER與TAK_TRACKER角色使用。此設定會停止所有轉發，效果類似CLIENT_MUTE角色。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅允許 SENSOR、TRACKER 和 TAK_TRACKER 角色使用，這將抑制所有轉發，類似於 CLIENT_MUTE 角色。"
          }
        }
      }
    },
