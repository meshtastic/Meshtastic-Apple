    "If you device has the proper updater loaded into the OTA_1 partition, you can attempt to use the BLE update process." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dein Gerät die richtige Aktualisierungssoftware in der OTA_1-Partition geladen hat, kannst du versuchen, den BLE-Aktualisierungsvorgang zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si tu dispositivo tiene el actualizador adecuado cargado en la partición OTA_1, puedes intentar utilizar el proceso de actualización BLE."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
