        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無線電將重新啟動以套用此設定，並在幾秒後重新連線。"
          }
        }
      }
    },
    "Your radio is restarting with its new LoRa settings. Saving the name works once it is back." : {
