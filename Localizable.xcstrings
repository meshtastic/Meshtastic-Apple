          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PKIを使用します。ノードで自分のIDがリモート管理者として承認されている必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PKI를 사용합니다. 노드가 사용자의 ID를 원격 관리자로 승인해야 합니다."
          }
        },
        "pl" : {
