    "meshtastic.Config.LoRaConfig.coding_rate.description" : {
      "comment" : "description of meshtastic.Config.LoRaConfig.coding_rate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Redundanz der Fehlerkorrektur, als Nenner von 4/n. Höhere Werte halten gestörteren Verbindungen stand, machen aber jedes Paket länger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Error-correction redundancy, as the denominator of 4/n. Higher values survive noisier links but make every packet longer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Redundancia de corrección de errores, expresada como el denominador de 4/n. Los valores más altos resisten mejor los enlaces con ruido, pero alargan cada paquete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Redondance de la correction d’erreurs, exprimée comme le dénominateur de 4/n. Des valeurs plus élevées résistent mieux aux liaisons bruitées, mais allongent chaque paquet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ridondanza della correzione degli errori, espressa come denominatore di 4/n. Valori più alti resistono meglio ai collegamenti disturbati, ma rendono ogni pacchetto più lungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "誤り訂正の冗長性（4/nの分母で指定）。値を大きくするとノイズの多いリンクでも届きやすくなりますが、すべてのパケットが長くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "4/n의 분모로 나타낸 오류 정정 중복도입니다. 값이 높을수록 잡음이 많은 링크에서도 잘 전달되지만 모든 패킷이 길어집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nadmiarowość korekcji błędów jako mianownik ułamka 4/n. Wyższe wartości lepiej znoszą zakłócone łącza, ale wydłużają każdy pakiet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Redundância da correção de erros, expressa como o denominador de 4/n. Valores mais altos resistem melhor a enlaces com ruído, mas deixam cada pacote mais longo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Избыточность коррекции ошибок, задаваемая знаменателем в 4/n. Более высокие значения лучше выдерживают зашумленные линии связи, но удлиняют каждый пакет."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Надлишковість корекції помилок, задана як знаменник у 4/n. Вищі значення краще витримують зашумлені лінії зв’язку, але подовжують кожен пакет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "纠错冗余，以 4/n 的分母表示。值越高，越能适应噪声较大的链路，但每个数据包都会变长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "錯誤更正的冗餘度，以4/n的分母表示。較高的值較能承受雜訊較多的連結，但每個封包都會變長。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錯誤更正冗餘度，以 4/n 的分母表示。數值越高，越能承受雜訊較多的鏈路，但每個封包也會變長。"
          }
        }
      }
    },
