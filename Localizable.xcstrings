    "meshtastic.ModuleConfig.AudioConfig.codec2_enabled.description" : {
      "comment" : "description of meshtastic.ModuleConfig.AudioConfig.codec2_enabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aktiviere die Codec2-Audiokodierung/-dekodierung für Sprachkommunikation über das Mesh."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable Codec2 audio encoding/decoding for voice communication over the mesh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Habilita la codificación y decodificación de audio Codec2 para la comunicación de voz a través de la red mallada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Activez l’encodage/décodage audio Codec2 pour les communications vocales sur le réseau maillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abilita la codifica/decodifica audio Codec2 per le comunicazioni vocali sulla mesh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "メッシュ経由の音声通信のため、Codec2オーディオのエンコード/デコードを有効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesh 음성 통신을 위한 Codec2 오디오 인코딩/디코딩을 활성화합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Włącz kodowanie i dekodowanie dźwięku Codec2 do komunikacji głosowej przez sieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ative a codificação/decodificação de áudio Codec2 para comunicação por voz pela mesh."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Включить кодирование/декодирование аудио Codec2 для голосовой связи через сеть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнути кодування/декодування аудіо Codec2 для голосового зв’язку через mesh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "启用 Codec2 音频编解码，以通过 Mesh 网络进行语音通信。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "啟用Codec2音訊編碼/解碼，以透過網格進行語音通訊。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用 Codec2 音訊編解碼，以在網狀網路上進行語音通訊。"
          }
        }
      }
    },
