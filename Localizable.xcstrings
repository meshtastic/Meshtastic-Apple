    "Local airtime limits are temporarily blocking sends. Wait before trying again." : {
      "comment" : "RoutingError.description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lokale Airtime-Limits blockieren das Senden vorübergehend. Warte, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los límites locales de tiempo de emisión están bloqueando temporalmente los envíos. Espere antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les limites locales de temps d’émission bloquent temporairement les envois. Patientez avant de réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I limiti locali del tempo di trasmissione stanno bloccando temporaneamente gli invii. Attendi prima di riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ローカルのエアタイム制限により、送信が一時的にブロックされています。しばらく待ってから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "로컬 송신 시간 제한으로 인해 일시적으로 전송이 차단되었습니다. 잠시 기다린 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os limites locais de tempo de transmissão estão bloqueando os envios temporariamente. Aguarde antes de tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Локальные ограничения эфирного времени временно блокируют отправку. Подождите, прежде чем повторить попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Локальні обмеження ефірного часу тимчасово блокують надсилання. Зачекайте, перш ніж спробувати знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "本地广播时间限制暂时阻止了发送。请稍候再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "本地發射時間限制暫時阻止傳送。請稍候再試。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地發射時間限制暫時阻止傳送。請等待後重試。"
          }
        }
      }
    },
