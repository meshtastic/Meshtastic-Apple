          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie zamykaj aplikacji podczas aktualizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não feche o aplicativo durante a atualização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не закрывайте приложение во время обновления."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закривайте застосунок під час оновлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请勿在更新期间关闭应用程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "請勿在更新期間關閉應用程式。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請勿在更新期間關閉應用程式。"
          }
        }
      }
    },
    "Do not close the app or turn off Bluetooth while the update is in progress." : {
      "comment" : "OTA update tip: do not close app",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schließe die App nicht und schalte Bluetooth nicht aus, während das Update läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cierres la aplicación ni desactives el Bluetooth mientras se esté realizando la actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ne fermez pas l’app et ne désactivez pas Bluetooth pendant la mise à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non chiudere l’app e non disattivare Bluetooth mentre l’aggiornamento è in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "アップデート中は、アプリを閉じたりBluetoothをオフにしたりしないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "업데이트가 진행되는 동안 앱을 종료하거나 Bluetooth를 끄지 마십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie zamykaj aplikacji i nie wyłączaj Bluetootha podczas aktualizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não feche o app nem desligue o Bluetooth enquanto a atualização estiver em andamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не закрывайте приложение и не выключайте Bluetooth, пока идет обновление."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не закривайте застосунок і не вимикайте Bluetooth, доки триває оновлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "更新期间，请勿退出 App 或关闭 Bluetooth。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
