    "Advertise this mesh so nearby radios can find and join it." : {
      "comment" : "A description of the \"Broadcast a Beacon\" toggle.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mache dieses Mesh bekannt, damit Funkgeräte in der Nähe es finden und ihm beitreten können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuncie esta malla para que las radios cercanas puedan encontrarla y unirse a ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annoncez ce réseau maillé afin que les radios à proximité puissent le trouver et le rejoindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Annuncia questa mesh in modo che le radio vicine possano trovarla e unirsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "近くの無線機が見つけて参加できるように、このメッシュを告知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "근처 라디오가 찾아서 참여할 수 있도록 이 메시를 알립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ogłaszaj tę sieć, aby pobliskie radia mogły ją znaleźć i do niej dołączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anuncie esta mesh para que rádios próximos possam encontrá-la e entrar nela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
