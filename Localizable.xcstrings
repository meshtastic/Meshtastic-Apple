    "This device has not reported whether it supports packet signature verification. Update its firmware to configure this setting." : {
      "comment" : "Note shown when a radio has not reported its packet signature verification capability.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieses Gerät hat nicht gemeldet, ob es die Überprüfung von Paketsignaturen unterstützt. Aktualisiere seine Firmware, um diese Einstellung zu konfigurieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no ha indicado si admite la verificación de firma de paquetes. Actualice su firmware para configurar esta opción."
