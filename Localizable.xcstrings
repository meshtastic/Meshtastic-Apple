    "meshtastic.ClientNotification.NotificationType.TELEMETRY_SENT_SLEEPING.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.TELEMETRY_SENT_SLEEPING",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Telemetrie gesendet. Das Gerät schläft bis zur nächsten Telemetrieaktualisierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Telemetry sent. The device will sleep until the next telemetry update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Telemetría enviada. El dispositivo entrará en reposo hasta la próxima actualización de telemetría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Télémétrie envoyée. L’appareil restera en veille jusqu’à la prochaine mise à jour de la télémétrie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
