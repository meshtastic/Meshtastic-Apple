    "Linux nodes running meshtasticd send their uptime, free memory, load and free disk space." : {
      "comment" : "Host Metrics log: shown before any readings arrive",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Linux-Knoten mit meshtasticd senden ihre Uptime, den freien Arbeitsspeicher, die Last und den freien Speicherplatz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los nodos Linux que ejecutan meshtasticd envían su tiempo de actividad, memoria libre, carga y espacio libre en disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les nœuds Linux exécutant meshtasticd envoient leur temps d’activité, leur mémoire disponible, leur charge et leur espace disque disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I nodi Linux che eseguono meshtasticd inviano tempo di attività, memoria libera, carico e spazio libero su disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "meshtasticdを実行しているLinuxノードは、稼働時間、空きメモリ、負荷、およびディスクの空き容量を送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "meshtasticd를 실행하는 Linux 노드는 가동 시간, 여유 메모리, 부하 및 디스크 여유 공간을 전송합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
