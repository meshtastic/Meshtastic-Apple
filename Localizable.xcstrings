    "Uses %@'s 4/%lld coding rate. Turn this off only when nearby nodes use the same preset and you want extra error correction on noisy links." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verwendet die Codierrate 4/%2$lld von %1$@. Schalte dies nur aus, wenn Knoten in der Nähe dieselbe Voreinstellung verwenden und du bei gestörten Verbindungen zusätzliche Fehlerkorrektur möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses %1$@'s 4/%2$lld coding rate. Turn this off only when nearby nodes use the same preset and you want extra error correction on noisy links."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza la tasa de codificación 4/%2$lld de %1$@. Desactívela únicamente cuando los nodos cercanos utilicen el mismo preajuste y desee una corrección de errores adicional en enlaces con ruido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilise le taux de codage 4/%2$lld de %1$@. Désactivez cette option uniquement si les nœuds à proximité utilisent le même préréglage et que vous souhaitez une correction d’erreurs supplémentaire sur les liaisons bruitées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa il tasso di codifica 4/%2$lld di %1$@. Disattiva questa opzione solo se i nodi vicini usano lo stesso preset e vuoi una correzione degli errori aggiuntiva sui collegamenti disturbati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@の符号化率4/%2$lldを使用します。近くのノードが同じプリセットを使用していて、ノイズの多いリンクで誤り訂正を強化したい場合にのみ、オフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@의 4/%2$lld 코딩률을 사용합니다. 주변 노드가 같은 프리셋을 사용하고 잡음이 많은 링크에서 추가 오류 정정이 필요한 경우에만 이 옵션을 끄십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa a taxa de codificação 4/%2$lld do %1$@. Desative esta opção só quando os nós próximos usarem o mesmo preset e você quiser correção de erros extra em enlaces com ruído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Использует скорость кодирования 4/%2$lld пресета %1$@. Выключайте, только если ноды поблизости используют тот же пресет и вам нужна дополнительная коррекция ошибок на зашумленных линиях связи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Використовує швидкість кодування 4/%2$lld пресета %1$@. Вимикайте це, лише коли вузли поблизу використовують той самий пресет і вам потрібна додаткова корекція помилок на зашумлених лініях зв’язку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用 %1$@ 的 4/%2$lld 编码率。仅当附近节点使用相同预设，且您希望在噪声较大的链路上获得额外纠错时，才关闭此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用%1$@的4/%2$lld編碼速率。僅在附近節點使用相同預設，且您希望在雜訊較多的連結上獲得額外錯誤更正時，才關閉此選項。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 %1$@ 的 4/%2$lld 編碼率。僅當附近節點使用相同的預設且您想要在雜訊連結上進行額外的錯誤校正時才關閉此選項。"
          }
        }
      }
    },
    "Uses 4/%lld while keeping the %@ bandwidth and spread factor. Higher values add error correction, but each packet uses more airtime and has less throughput." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verwendet 4/%1$lld und behält Bandbreite und Spreizfaktor von %2$@ bei. Höhere Werte erhöhen die Fehlerkorrektur, aber jedes Paket braucht mehr Airtime und hat weniger Durchsatz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses 4/%1$lld while keeping the %2$@ bandwidth and spread factor. Higher values add error correction, but each packet uses more airtime and has less throughput."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza 4/%1$lld manteniendo el ancho de banda y el factor de dispersión de %2$@. Valores más altos añaden corrección de errores, pero cada paquete utiliza más tiempo de transmisión y tiene menor rendimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilise 4/%1$lld tout en conservant la bande passante et le facteur de diffusion de %2$@. Des valeurs plus élevées ajoutent de la correction d’erreurs, mais chaque paquet occupe plus de temps d’antenne et offre un débit plus faible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa 4/%1$lld mantenendo la larghezza di banda e il fattore di diffusione di %2$@. Valori più alti aggiungono correzione degli errori, ma ogni pacchetto richiede più tempo di trasmissione e la velocità di trasmissione dati si riduce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@の帯域幅と拡散係数を維持したまま、4/%1$lldを使用します。値を大きくすると誤り訂正が強化されますが、各パケットのエアタイムが増え、スループットが低下します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%2$@의 대역폭과 확산 계수를 유지하면서 4/%1$lld을(를) 사용합니다. 값이 높을수록 오류 정정이 강화되지만 각 패킷의 송신 시간이 늘어나고 처리량이 줄어듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa 4/%1$lld mantendo a largura de banda e o fator de espalhamento do %2$@. Valores mais altos adicionam correção de erros, mas cada pacote usa mais tempo no ar e tem menor taxa de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Использует 4/%1$lld, сохраняя ширину полосы и коэффициент распространения пресета %2$@. Более высокие значения добавляют коррекцию ошибок, но каждый пакет занимает больше эфирного времени и снижает пропускную способность."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Використовує 4/%1$lld, зберігаючи ширину смуги та spread factor пресета %2$@. Вищі значення додають корекцію помилок, але кожен пакет займає більше ефірного часу й має меншу пропускну здатність."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用 4/%1$lld，同时保持 %2$@ 的带宽和传播因子。较高的值会增加纠错能力，但每个数据包会占用更多广播时间，吞吐量也会降低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用4/%1$lld，同時保留%2$@的頻寬與傳播因子。較高的值會增加錯誤更正，但每個封包會占用更多空中傳輸時間，傳輸量也會降低。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 4/%1$lld 同時保持 %2$@ 頻寬和擴展因子。較高的值增加錯誤校正，但每個封包使用更多的發射時間並具有較低的吞吐量。"
          }
        }
      }
    },
    "Uses PKI. The node must authorize your identity as a remote admin." : {
      "comment" : "A description of the remote admin method of sending a local stats request.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
