    "Older or legacy device that still receives firmware updates but may lack some features." : {
      "comment" : "SupportLevel.description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Älteres Gerät, das weiterhin Firmware-Updates erhält, dem aber möglicherweise einige Funktionen fehlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dispositivo antiguo que todavía recibe actualizaciones de firmware, pero al que pueden faltarle algunas funciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appareil ancien qui reçoit encore des mises à jour du firmware, mais auquel certaines fonctionnalités peuvent manquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dispositivo meno recente o datato che riceve ancora aggiornamenti firmware, ma a cui potrebbero mancare alcune funzionalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ファームウェアアップデートは引き続き提供されるものの、一部の機能がない可能性がある旧型またはレガシーのデバイス。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "펌웨어 업데이트는 계속 제공되지만 일부 기능이 없을 수 있는 구형 또는 레거시 장치입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dispositivo mais antigo que ainda recebe atualizações de firmware, mas pode não ter alguns recursos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Старое или устаревшее устройство, которое еще получает обновления прошивки, но может не поддерживать некоторые функции."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Старіший або застарілий пристрій, який досі отримує оновлення прошивки, але може не мати деяких функцій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "较旧或旧款设备，仍可接收固件更新，但可能缺少部分功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仍可接收韌體更新，但可能缺少部分功能的較舊或舊款設備。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍接收韌體更新但可能缺少某些功能的舊版或舊型裝置。"
          }
        }
      }
    },
