        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ten region może wymagać firmware'u w wersji dla danego języka, aby tekst na urządzeniu wyświetlał się poprawnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
