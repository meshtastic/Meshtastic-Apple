    "Ignores observed messages from foreign meshes like Local Only, but takes it step further by also ignoring messages from nodes not already in the node's known list." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignoriert beobachtete Nachrichten aus fremden Meshes wie „Nur lokal“, geht aber noch einen Schritt weiter und ignoriert auch Nachrichten von Knoten, die noch nicht in der Liste bekannter Knoten stehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora los mensajes observados de mallas externas, como “Sólo Local”, pero va un paso más allá e ignora también los mensajes de nodos que aún no están en la lista de nodos conocidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignore les messages observés provenant de réseaux maillés étrangers, comme « Local uniquement », mais va plus loin en ignorant aussi les messages des nœuds qui ne figurent pas déjà dans la liste des nœuds connus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora i messaggi osservati provenienti da mesh esterne, come “Solo locale”, ma va oltre ignorando anche i messaggi dei nodi che non sono già nell’elenco dei nodi conosciuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“ローカルのみ”と同様に外部メッシュから受信したメッセージを無視し、さらにノードの既知リストにないノードからのメッセージも無視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "‘로컬 전용’과 마찬가지로 다른 메시에서 수신한 메시지를 무시하며, 여기에 더해 노드의 알려진 노드 목록에 없는 노드의 메시지도 무시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora mensagens observadas de meshes externas, como em “Somente Local”, mas vai além e também ignora mensagens de nós que ainda não estão na lista de nós conhecidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Как и режим «Только локальные», игнорирует сообщения из чужих сетей, но идет дальше: также игнорирует сообщения от нод, которых еще нет в списке известных нод."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ігнорує спостережувані повідомлення з чужих mesh-мереж, як і «Лише локальні», але йде ще далі й також ігнорує повідомлення від вузлів, яких ще немає в списку відомих вузлів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "与“仅本地”一样忽略来自外部 Mesh 网络的消息，但更进一步，还会忽略不在节点已知列表中的节点所发送的消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "與「僅限本地」相同，會忽略從外部網格收到的訊息，但更進一步，也會忽略不在節點已知列表中的節點所傳送的訊息。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與「僅本機」類似忽略外部 Mesh 訊息，但更進一步忽略不在節點已知列表中的節點訊息。"
          }
        }
      }
    },
    "Ignores observed messages from foreign meshes that are open or those which it cannot decrypt. Only rebroadcasts message on the nodes local primary / secondary channels." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignoriert beobachtete Nachrichten aus fremden Meshes, die offen sind oder nicht entschlüsselt werden können. Leitet nur Nachrichten auf den lokalen primären/sekundären Kanälen des Knotens weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora los mensajes observados de mallas externas que estén abiertas o que no pueda descifrar. Solo retransmite mensajes en los canales locales principal y secundarios del nodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignore les messages observés provenant de réseaux maillés étrangers ouverts ou qu’il ne peut pas déchiffrer. Ne rediffuse que les messages des canaux locaux principal et secondaires du nœud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora i messaggi osservati provenienti da mesh esterne aperte o che non riesce a decifrare. Ritrasmette i messaggi solo sui canali locali principale e secondari del nodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "公開されている外部メッシュや復号できない外部メッシュから受信したメッセージを無視します。ノードのローカルのプライマリ/セカンダリチャンネル上のメッセージのみを再ブロードキャストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "공개된 다른 메시나 복호화할 수 없는 다른 메시에서 수신한 메시지를 무시합니다. 노드의 로컬 기본/보조 채널의 메시지만 중계합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora mensagens observadas de meshes externas que estão abertas ou que o nó não consegue descriptografar. Só retransmite mensagens nos canais locais principal e secundários do nó."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Игнорирует сообщения из чужих сетей, которые открыты или которые нода не может расшифровать. Ретранслирует сообщения только на локальных первичном и вторичных каналах ноды."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ігнорує помічені повідомлення з чужих mesh-мереж, які відкриті або які неможливо розшифрувати. Ретранслює повідомлення лише на локальних основному та вторинних каналах вузла."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "忽略来自开放的外部 Mesh 网络或无法解密的消息。仅转发节点本地主要/次要频道上的消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "忽略從開放或無法解密的外部網格收到的訊息。僅轉發節點本地主要/次要頻道上的訊息。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略來自開放外部 Mesh 或無法解密的訊息。僅在節點的本機主要/次要頻道上轉發訊息。"
          }
        }
      }
    },
