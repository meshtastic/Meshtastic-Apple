    "meshtastic.ModuleConfig.AudioConfig.bitrate.description" : {
      "comment" : "description of meshtastic.ModuleConfig.AudioConfig.bitrate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die zu verwendende Codec2-Bitrate. Die Abtastrate beträgt immer 8 kHz. Niedrigere Bitraten benötigen weniger Bandbreite, verringern aber die Audioqualität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Codec2 bitrate to use. The sample rate is always 8 kHz. Lower bitrates use less bandwidth but reduce audio quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define la tasa de bits de Codec2. La frecuencia de muestreo es siempre de 8 kHz. Las tasas de bits más bajas consumen menos ancho de banda, pero reducen la calidad del audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Débit binaire Codec2 à utiliser. La fréquence d’échantillonnage est toujours de 8 kHz. Les débits plus faibles utilisent moins de bande passante, mais réduisent la qualité audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il bitrate Codec2 da usare. La frequenza di campionamento è sempre 8 kHz. I bitrate più bassi usano meno larghezza di banda ma riducono la qualità audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Codec2で使用するビットレートです。サンプルレートは常に8 kHzです。ビットレートを低くすると使用する帯域幅は減りますが、音質が低下します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "사용할 Codec2 비트레이트입니다. 샘플링 레이트는 항상 8 kHz입니다. 낮은 비트레이트는 대역폭을 적게 사용하지만 음질이 저하됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bitrate Codec2. Częstotliwość próbkowania to zawsze 8 kHz. Niższy bitrate zużywa mniej pasma, ale obniża jakość dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A taxa de bits do Codec2 a ser usada. A taxa de amostragem é sempre de 8 kHz. Taxas de bits menores usam menos largura de banda, mas reduzem a qualidade do áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Битрейт Codec2. Частота дискретизации всегда 8 кГц. Более низкий битрейт требует меньшей пропускной способности, но снижает качество звука."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Бітрейт Codec2. Частота дискретизації завжди 8 кГц. Нижчий бітрейт використовує менше смуги, але погіршує якість аудіо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要使用的 Codec2 比特率。采样率固定为 8 kHz。较低的比特率占用的带宽更少，但会降低音质。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "要使用的Codec2位元率。取樣率固定為8 kHz。較低的位元率會使用較少頻寬，但會降低音質。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用的 Codec2 位元率。取樣率固定為 8 kHz。較低的位元率使用較少頻寬，但會降低音質。"
          }
        }
      }
    },
