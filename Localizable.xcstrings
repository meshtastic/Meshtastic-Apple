    "Nodes advertising a mesh to join. A preset offered by a beacon is added to the scan automatically." : {
      "comment" : "A description of the beacons section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Knoten, die ein Mesh zum Beitreten bekannt machen. Eine von einem Beacon angebotene Voreinstellung wird automatisch zum Scan hinzugefügt."
