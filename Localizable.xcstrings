    "Open Meshtastic and connect once. You can share later while disconnected." : {
      "comment" : "A description of the content that is unavailable when there is no recent radio.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffne Meshtastic und verbinde dich einmal. Danach kannst du auch ohne Verbindung teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Meshtastic y conéctate una vez. Podrás compartir más tarde, aunque estés desconectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvrez Meshtastic et connectez-vous une fois. Vous pourrez ensuite partager même sans connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apri Meshtastic ed esegui la connessione una volta. In seguito potrai condividere anche senza connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Meshtasticを開いて一度接続してください。その後は接続していなくても共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Meshtastic을 열고 한 번 연결하십시오. 이후에는 연결되지 않은 상태에서도 공유할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Meshtastic i połącz się raz. Później możesz udostępniać bez połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abra o Meshtastic e conecte-se uma vez. Depois, você pode compartilhar mesmo sem conexão."
