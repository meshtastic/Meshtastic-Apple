    "meshtastic.ClientNotification.NotificationType.PUBLIC_CHANNEL_POSITION_PRECISION_REDUCED.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.PUBLIC_CHANNEL_POSITION_PRECISION_REDUCED",
