    "meshtastic.Config.DeviceConfig.Role.CLIENT_HIDDEN.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.Role.CLIENT_HIDDEN",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gerät, das nur bei Bedarf sendet, um unauffällig zu bleiben oder Strom zu sparen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Device that only broadcasts as needed for stealth or power savings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dispositivo que solo difunde cuando es necesario, para pasar desapercibido o ahorrar energía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appareil qui n’émet qu’en cas de besoin, pour rester discret ou économiser l’énergie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dispositivo che trasmette solo quando necessario, per restare invisibile o risparmiare energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ステルスまたは省電力のために、必要なときだけブロードキャストするデバイス。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "은신 또는 절전을 위해 필요할 때만 브로드캐스트하는 장치입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Urządzenie, które nadaje tylko w razie potrzeby, dla dyskrecji lub oszczędzania energii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dispositivo que só transmite quando necessário, para ficar discreto ou economizar energia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Устройство, которое передает только при необходимости — для скрытности или энергосбережения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Пристрій, який транслює лише за потреби — для скритності або енергозбереження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "仅在需要时广播的设备，用于隐蔽或省电。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
