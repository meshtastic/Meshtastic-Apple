        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• A continuación, instale el firmware desde la pantalla de Actualizaciones de firmware. La radio se iniciará como un dispositivo nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
