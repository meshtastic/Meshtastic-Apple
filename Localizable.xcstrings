    "Groups nearby nodes into one numbered pin; tap it to zoom in. Turn off to always show every node." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fasst Knoten in der Nähe zu einem nummerierten Pin zusammen; tippe darauf, um hineinzuzoomen. Deaktiviere die Option, um immer jeden Knoten anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa los nodos cercanos en un marcador numerado; tócalo para acercar la imagen. Desactiva esta opción para mostrar siempre todos los nodos."
          }
        },
        "fr" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Regroupe les nœuds proches en une seule épingle numérotée ; touchez-la pour zoomer. Désactivez cette option pour toujours afficher tous les nœuds."
                }
              },
              "iphone" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Regroupe les nœuds proches en une seule épingle numérotée ; touchez-la pour zoomer. Désactivez cette option pour toujours afficher tous les nœuds."
                }
              },
              "mac" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Regroupe les nœuds proches en une seule épingle numérotée ; cliquez dessus pour zoomer. Désactivez cette option pour toujours afficher tous les nœuds."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Regroupe les nœuds proches en une seule épingle numérotée ; sélectionnez-la pour zoomer. Désactivez cette option pour toujours afficher tous les nœuds."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Raggruppa i nodi vicini in un unico pin numerato; toccalo per ingrandire. Disattiva l’opzione per mostrare sempre tutti i nodi."
