          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nós Linux que executam o meshtasticd enviam o tempo de atividade, a memória livre, a carga e o espaço livre em disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
