    "Send text, positions and more over LoRa radios. No cell service or internet needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sende Text, Positionen und mehr über LoRa-Funkgeräte. Kein Mobilfunk oder Internet nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Envía texto, posiciones y mucho más a través de radios LoRa. Sin necesidad de cobertura móvil ni internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Envoyez du texte, des positions et plus encore via des radios LoRa. Aucun réseau cellulaire ni Internet requis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Invia testo, posizioni e altro tramite radio LoRa. Non servono né rete cellulare né internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "LoRa無線機でテキストや位置情報などを送信できます。携帯電話の電波やインターネットは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "LoRa 무선 장치로 텍스트, 위치 등을 보낼 수 있습니다. 셀룰러 서비스나 인터넷이 필요하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj tekst, pozycje i nie tylko przez radia LoRa. Bez zasięgu komórkowego i internetu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Envie textos, posições e muito mais por rádios LoRa. Sem precisar de sinal de celular ou internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отправляйте текст, позиции и многое другое через радиостанции LoRa. Сотовая связь и интернет не нужны."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Надсилайте текст, позиції та інше через LoRa-радіостанції. Мобільний звʼязок чи інтернет не потрібні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "通过 LoRa 电台发送文本、位置等信息，无需蜂窝网络或互联网。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
