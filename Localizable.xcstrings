    "meshtastic.Config.DeviceConfig.RebroadcastMode.CORE_PORTNUMS_ONLY.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.RebroadcastMode.CORE_PORTNUMS_ONLY",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignoriert Pakete auf Nicht-Kern-Portnums wie Range Test, PAX Counter und ATAK und leitet sie nicht weiter. Zu den Kern-Portnums gehören Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute und Store and Forward."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ignores packets on non-core portnums such as Range Test, PAX Counter and ATAK, and does not rebroadcast them. Core portnums include Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute and Store and Forward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora los paquetes de portnums no principales, como Range Test, PAX Counter y ATAK, y no los retransmite. Los portnums principales incluyen Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute y Store and Forward."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignore les paquets des portnums non principaux, comme Range Test, PAX Counter et ATAK, et ne les retransmet pas. Les portnums principaux comprennent Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute et Store and Forward."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora i pacchetti dei portnum non principali, come Range Test, PAX Counter e ATAK, e non li ritrasmette. I portnum principali includono Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute e Store and Forward."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Range Test、PAX Counter、ATAKなど、コア以外のPortnumのパケットを無視し、再ブロードキャストしません。コアPortnumには、Text、Position、NodeInfo、Telemetry、Routing、Admin、Waypoint、Traceroute、およびStore and Forwardが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Range Test, PAX Counter, ATAK 등 핵심이 아닌 Portnum의 패킷은 무시하고 중계하지 않습니다. 핵심 Portnum에는 Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute, Store and Forward가 포함됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ignoruje pakiety z niepodstawowych portnumów, takich jak Range Test, PAX Counter i ATAK, i ich nie przekazuje. Podstawowe portnumy to Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute i Store and Forward."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ignora pacotes de portnums não principais, como Range Test, PAX Counter e ATAK, e não os retransmite. Os portnums principais incluem Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute e Store and Forward."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Игнорирует пакеты неосновных Portnum, таких как Range Test, PAX Counter и ATAK, и не ретранслирует их. К основным Portnum относятся Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute и Store and Forward."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ігнорує пакети неосновних Portnum, як-от Range Test, PAX Counter і ATAK, і не ретранслює їх. До основних Portnum належать Text, Position, NodeInfo, Telemetry, Routing, Admin, Waypoint, Traceroute і Store and Forward."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "忽略非核心 Portnum 的数据包（如 Range Test、PAX Counter 和 ATAK），且不予转发。核心 Portnum 包括 Text、Position、NodeInfo、Telemetry、Routing、Admin、Waypoint、Traceroute 和 Store and Forward。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "忽略非核心Portnum的封包（例如Range Test、PAX Counter與ATAK），且不轉發。核心Portnum包括Text、Position、NodeInfo、Telemetry、Routing、Admin、Waypoint、Traceroute與Store and Forward。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略非核心埠號的封包（例如範圍測試、PAX 計數器與 ATAK），且不轉發。核心埠號包括 Text、Position、NodeInfo、Telemetry、Routing、Admin、Waypoint、Traceroute 與 Store and Forward。"
          }
        }
      }
    },
