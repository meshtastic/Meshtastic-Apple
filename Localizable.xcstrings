    "meshtastic.Config.DeviceConfig.RebroadcastMode.NONE.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.RebroadcastMode.NONE",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unterdrückt alle Weiterleitungen, wie die Rolle Client Mute. Für die Rollen Router und Router Late nicht zulässig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inhibits all rebroadcasts, like the Client Mute role. Not allowed on the Router and Router Late roles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impide todas las retransmisiones, como el rol Cliente Silenciado. No se permite en los roles Router y Router Late."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Empêche toutes les retransmissions, comme le rôle Client Mute. Non autorisé pour les rôles Router et Router Late."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impedisce tutte le ritrasmissioni, come il ruolo Client Mute. Non consentito per i ruoli Router e Router Late."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "クライアント（ミュート）の役割と同様に、すべての再ブロードキャストを停止します。RouterおよびRouter Lateの役割では使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Client Mute 역할과 마찬가지로 모든 중계를 차단합니다. Router 및 Router Late 역할에서는 사용할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Blokuje wszystkie przekazania, jak rola Client Mute. Niedozwolone w rolach Router i Router Late."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impede todas as retransmissões, como o papel Client Mute. Não é permitido nos papéis Router e Router Late."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Блокирует все ретрансляции, подобно роли Client Mute. Недоступно для ролей Router и Router Late."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Блокує всі ретрансляції, як роль Client Mute. Недоступно для ролей Router і Router Late."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "禁止所有转发，与 Client Mute 角色相同。Router 和 Router Late 角色不可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "停止所有轉發，效果與Client Mute角色相同。Router與Router Late角色不可使用。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
