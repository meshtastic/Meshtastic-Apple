    "Authenticate packets when possible, but accept unsigned traffic for maximum compatibility." : {
      "comment" : "Description of the Compatible packet authenticity policy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pakete nach Möglichkeit authentifizieren, aber unsignierten Datenverkehr für maximale Kompatibilität akzeptieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentique los paquetes siempre que sea posible, pero acepte el tráfico sin verificar para una máxima compatibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Authentifie les paquets si possible, mais accepte le trafic non signé pour une compatibilité maximale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autentica i pacchetti quando possibile, ma accetta il traffico non firmato per la massima compatibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "可能な場合はパケットを認証しますが、互換性を最大限に保つため署名のないトラフィックも受け入れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능한 경우 패킷을 인증하지만, 최대 호환성을 위해 서명되지 않은 트래픽도 허용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autentica os pacotes quando possível, mas aceita tráfego não assinado para máxima compatibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Проверять подлинность пакетов, когда это возможно, но принимать неподписанный трафик для максимальной совместимости."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Автентифікувати пакети, коли це можливо, але приймати непідписаний трафік для максимальної сумісності."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "尽可能验证数据包，但为实现最大兼容性，也接受未签名的流量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "盡可能驗證封包，但為了最大相容性，也接受未簽署的流量。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盡可能驗證封包，但為了最大相容性接受未簽署的流量。"
          }
        }
      }
    },
