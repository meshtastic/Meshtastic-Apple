    "meshtastic.ClientNotification.NotificationType.CHANNEL_NAME_MATCHES_OLD_PRESET.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.CHANNEL_NAME_MATCHES_OLD_PRESET",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Kanalname entspricht der vorherigen Modem-Voreinstellung. Benenne ihn um, wenn er der neuen Voreinstellung folgen soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A channel name matches the previous modem preset. Rename it if it should follow the new preset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un nombre de canal coincide con el preajuste de módem anterior. Cámbiale el nombre si debe seguir el nuevo preajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le nom d’un canal correspond au préréglage de modem précédent. Renommez-le s’il doit suivre le nouveau préréglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il nome di un canale corrisponde alla preimpostazione del modem precedente. Rinominalo se deve seguire la nuova preimpostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "チャンネル名が以前のモデムプリセットと一致しています。新しいプリセットに合わせる場合は、名前を変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "채널 이름이 이전 모뎀 프리셋과 일치합니다. 새 프리셋을 따르게 하려면 이름을 변경하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nazwa kanału pasuje do poprzedniego presetu modemu. Zmień ją, jeśli kanał ma iść za nowym presetem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um nome de canal corresponde ao preset do modem anterior. Renomeie o canal se ele precisar seguir o novo preset."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Имя канала совпадает с предыдущим пресетом модема. Переименуйте канал, если он должен соответствовать новому пресету."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Назва каналу збігається з попереднім пресетом модема. Перейменуйте канал, якщо він має відповідати новому пресету."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有频道名称与之前的调制解调器预设相同。如果该频道应跟随新预设，请将其重命名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有頻道名稱與先前的數據機預設相同。若該頻道應跟隨新的預設，請將其重新命名。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有頻道名稱與先前的數據機預設相同。若要讓它跟隨新預設，請重新命名。"
          }
        }
      }
    },
