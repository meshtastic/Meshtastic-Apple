    "lockdown.session.cap_caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Laufzeitlimit pro Start. Leer lassen für kein Limit. Das Gerät startet neu, wenn das Limit abgelaufen ist; der nächste Start entsperrt automatisch über die TTL des Startzählers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Per-boot uptime cap. Leave empty for no cap. Device reboots when the cap elapses; next boot auto-unlocks via the boot-count TTL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límite de tiempo de actividad por arranque. Déjelo en blanco para no establecer ningún límite. El dispositivo se reinicia cuando se alcanza el límite; el siguiente arranque se desbloquea automáticamente mediante el TTL del contador de arranque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durée de fonctionnement maximale par démarrage. Laissez vide pour ne fixer aucune limite. L’appareil redémarre lorsque la limite est atteinte ; le démarrage suivant se déverrouille automatiquement grâce au TTL du nombre de démarrages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Limite di tempo di attività per ogni avvio. Lascia vuoto per nessun limite. Il dispositivo si riavvia allo scadere del limite; l’avvio successivo si sblocca automaticamente tramite il TTL del conteggio degli avvii."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "起動ごとの稼働時間の上限です。上限を設けない場合は空欄のままにしてください。上限に達するとデバイスが再起動し、次回の起動時に起動回数のTTLによって自動的にロックが解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부팅당 실행 시간 제한입니다. 제한을 두지 않으려면 비워 두세요. 제한 시간이 지나면 장치가 재부팅되며, 다음 부팅 시 부팅 횟수 TTL을 통해 자동으로 잠금 해제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Limite de tempo ativo por inicialização. Deixe em branco para não ter limite. O dispositivo reinicia quando o limite acaba; a próxima inicialização desbloqueia automaticamente pelo TTL da contagem de inicializações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Лимит времени работы на один запуск. Оставьте пустым, чтобы не ограничивать. Когда лимит истечет, устройство перезагрузится; следующий запуск разблокируется автоматически по TTL счетчика запусков."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмеження часу роботи для одного запуску. Залиште порожнім, щоб не встановлювати обмеження. Пристрій перезапуститься після завершення ліміту; наступний запуск автоматично розблокується через TTL кількості запусків."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次启动的运行时间上限。留空表示无上限。达到上限时设备将重启；下次启动将通过启动次数 TTL 自动解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次開機的運作時間上限。留空表示無上限。達到上限時設備會重新啟動；下次開機時會透過開機次數TTL自動解鎖。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次開機的運作時間上限。留空表示無上限。達到上限時裝置會重新啟動；下次開機將透過開機次數 TTL 自動解鎖。"
          }
        }
      }
    },
