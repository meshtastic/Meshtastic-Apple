    "meshtastic.ClientNotification.NotificationType.CHANNEL_PRESET_NON_DEFAULT_KEY.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.CHANNEL_PRESET_NON_DEFAULT_KEY",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Kanal entspricht einer Modem-Voreinstellung, verwendet aber nicht den Standard-Schlüssel. Knoten mit dem Standard-Schlüssel können ihn daher nicht entschlüsseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A channel matches a modem preset but uses a non-default key, so nodes using the default key can't decode it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un canal coincide con un preajuste de módem, pero usa una clave no predeterminada, por lo que los nodos que usan la clave predeterminada no pueden descifrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un canal correspond à un préréglage de modem, mais utilise une clé autre que celle par défaut ; les nœuds qui utilisent la clé par défaut ne peuvent donc pas le déchiffrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un canale corrisponde a una preimpostazione del modem ma usa una chiave non predefinita, quindi i nodi che usano la chiave predefinita non possono decodificarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "チャンネルがモデムプリセットと一致していますが、デフォルト以外のキーを使用しているため、デフォルトキーを使用するノードはこのチャンネルを復号できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "채널이 모뎀 프리셋과 일치하지만 기본 키가 아닌 키를 사용하므로, 기본 키를 사용하는 노드는 이 채널을 디코딩할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanał pasuje do presetu modemu, ale używa niedomyślnego klucza, więc węzły z domyślnym kluczem nie mogą go odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um canal corresponde a um preset do modem, mas usa uma chave diferente da padrão, então os nós que usam a chave padrão não conseguem decodificá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Канал соответствует пресету модема, но использует ключ не по умолчанию, поэтому ноды с ключом по умолчанию не могут его расшифровать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Канал відповідає пресету модема, але використовує нетиповий ключ, тому вузли з типовим ключем не можуть його розшифрувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有频道与调制解调器预设匹配，但使用的是非默认密钥，因此使用默认密钥的节点无法解码该频道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "有頻道與數據機預設相符，但使用非預設金鑰，因此使用預設金鑰的節點無法解碼。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有頻道符合數據機預設，但使用非預設金鑰，因此使用預設金鑰的節點無法解碼。"
          }
        }
      }
    },
