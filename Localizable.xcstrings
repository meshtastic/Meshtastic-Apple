        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Połączone radio nie obsługuje tej szerokości pasma w wybranym regionie. Przed zapisaniem wybierz obsługiwaną wartość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O rádio conectado não é compatível com esta largura de banda na região selecionada. Escolha um valor compatível antes de salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Подключенная радиостанция не поддерживает эту ширину полосы в выбранном регионе. Перед сохранением выберите поддерживаемое значение."
