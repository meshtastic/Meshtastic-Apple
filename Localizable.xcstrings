    "This radio's messages and nodes could not be backed up, so nothing was deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Nachrichten und Knoten dieses Funkgeräts konnten nicht gesichert werden, daher wurde nichts gelöscht."
