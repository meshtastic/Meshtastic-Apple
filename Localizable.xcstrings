    "Allow Meshtastic to send you notifications for messages, node events, and critical alerts. You can update notification permissions at any time from settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erlaube Meshtastic, dir Mitteilungen zu Nachrichten, Knotenereignissen und kritischen Hinweisen zu senden. Du kannst deine Mitteilungsberechtigungen jederzeit in den Einstellungen aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permite que Meshtastic te envíe notificaciones de mensajes, eventos de nodos y alertas críticas. Puedes actualizar los permisos de notificaciones en cualquier momento desde Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorisez Meshtastic à vous envoyer des notifications pour les messages, les évènements des nœuds et les alertes critiques. Vous pouvez modifier les autorisations de notification à tout moment dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Consenti a Meshtastic di inviarti notifiche per messaggi, eventi dei nodi e avvisi critici. Puoi modificare i permessi delle notifiche in qualsiasi momento dalle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "メッセージ、ノードのイベント、重要なアラートの通知をMeshtasticから受け取れるようにします。通知の許可は設定からいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Meshtastic이 메시지, 노드 이벤트 및 긴급 알림에 대한 알림을 보낼 수 있도록 허용하십시오. 알림 권한은 언제든지 설정에서 변경할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól aplikacji Meshtastic wysyłać powiadomienia o wiadomościach, zdarzeniach węzłów i alertach krytycznych. Uprawnienia do powiadomień możesz w każdej chwili zmienić w ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permita que o Meshtastic envie notificações de mensagens, eventos de nós e alertas críticos. Você pode atualizar as permissões de notificação a qualquer momento nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Разрешите Meshtastic отправлять уведомления о сообщениях, событиях нод и критические оповещения. Вы можете изменить разрешения на уведомления в любое время в настройках."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Дозвольте Meshtastic надсилати вам сповіщення про повідомлення, події вузлів і критичні сповіщення. Ви можете будь-коли змінити дозволи сповіщень у налаштуваннях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允许 Meshtastic 向您发送消息、节点事件和紧急警报通知。您可以在设置中随时更新通知权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允許Meshtastic傳送訊息、節點事件與關鍵警報的通知。隨時可在「設定」中更新通知權限。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 Meshtastic 傳送訊息、節點事件和重要警報的通知給您。您可以隨時從設定更新通知權限。"
          }
        }
      }
    },
