      }
    },
    "This region may require a locale-specific firmware file for correct on-device text rendering." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für diese Region ist möglicherweise eine sprachspezifische Firmware-Datei erforderlich, damit Text auf dem Gerät korrekt dargestellt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que esta región requiera un archivo de firmware específico para la configuración regional a fin de lograr una correcta visualización del texto en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette région peut nécessiter un fichier de firmware propre à la langue pour afficher correctement le texte sur l’appareil."
