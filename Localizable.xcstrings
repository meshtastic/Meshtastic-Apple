    "Swipe left to disconnect. Long press for more options." : {
      "comment" : "Bluetooth tip on the Connect screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
