    "Offline map storage is full. Delete a map in Offline Maps to download terrain for the whole mesh." : {
      "comment" : "Spatial map: terrain for the whole mesh does not fit in the offline map storage limit",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Speicher für Offlinekarten ist voll. Lösche eine Karte unter „Offlinekarten“, um Gelände für das gesamte Mesh herunterzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El almacenamiento de mapas sin conexión está lleno. Elimine un mapa en Mapas sin conexión para descargar el terreno de toda la malla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’espace de stockage des cartes hors ligne est plein. Supprimez une carte dans « Cartes hors ligne » pour télécharger le relief de l’ensemble du réseau maillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lo spazio per le mappe offline è pieno. Elimina una mappa in “Mappe offline” per scaricare il terreno di tutta la mesh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オフラインマップのストレージがいっぱいです。メッシュ全体の地形をダウンロードするには、「オフラインマップ」でマップを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "오프라인 지도 저장 공간이 가득 찼습니다. 전체 메시의 지형을 다운로드하려면 ‘오프라인 지도’에서 지도를 삭제하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce na mapy offline jest pełne. Usuń mapę w Mapach offline, aby pobrać teren dla całej sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O armazenamento de mapas off-line está cheio. Apague um mapa em Mapas Off-line para baixar o terreno de toda a mesh."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Хранилище офлайн-карт заполнено. Удалите карту в разделе «Офлайн-карты», чтобы загрузить рельеф для всей сети."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сховище офлайн-мап заповнене. Видаліть мапу в розділі «Офлайн-мапи», щоб завантажити рельєф для всієї mesh-мережі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "离线地图存储空间已满。请在“离线地图”中删除一张地图，以下载整个 Mesh 网络的地形。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "離線地圖儲存空間已滿。請在「離線地圖」中刪除一張地圖，以下載整個網格的地形。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線地圖儲存空間已滿。請在「離線地圖」中刪除一張地圖，以下載整個 Mesh 網路的地形。"
          }
        }
      }
    },
