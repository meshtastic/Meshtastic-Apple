    "Precipitation from NOAA radar, lower 48 states only. Needs a network connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Niederschlag vom NOAA-Radar, nur für die 48 zusammenhängenden US-Bundesstaaten. Benötigt eine Netzwerkverbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Precipitación del radar de la NOAA, solo para los 48 estados contiguos de EE. UU. Requiere conexión de red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Précipitations du radar de la NOAA, uniquement pour les 48 États contigus des États-Unis. Nécessite une connexion réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Precipitazioni dal radar NOAA, solo per i 48 stati contigui degli Stati Uniti. Richiede una connessione di rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "NOAAレーダーによる降水情報です（米国本土48州のみ）。ネットワーク接続が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "NOAA 레이더의 강수 정보이며, 미국 본토 48개 주만 지원합니다. 네트워크 연결이 필요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opady z radaru NOAA, tylko kontynentalne USA. Wymaga połączenia z siecią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
