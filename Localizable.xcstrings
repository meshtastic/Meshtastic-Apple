    "meshtastic.Config.DeviceConfig.Role.CLIENT_BASE.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.Role.CLIENT_BASE",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Knoten auf dem Dach oder Dachboden, der Pakete von oder an favorisierte Knoten wie Router Late weiterleitet und alle anderen wie Client."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rooftop or attic node that rebroadcasts like Router Late for packets from or to favorited nodes, and like Client for all others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nodo en un tejado o desván que retransmite como Router Late los paquetes procedentes de nodos favoritos o dirigidos a ellos, y como Cliente todos los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nœud installé sur un toit ou dans un grenier qui rediffuse comme Router Late les paquets provenant de nœuds favoris ou destinés à ceux-ci, et comme Client tous les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nodo sul tetto o in soffitta che ritrasmette come Router Late i pacchetti provenienti dai nodi preferiti o diretti a essi, e come Client tutti gli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "屋上または屋根裏に設置するノードです。お気に入りのノードとの間で送受信されるパケットはRouter Lateと同様に、それ以外のパケットはクライアントと同様に再ブロードキャストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "옥상이나 다락에 설치하는 노드로, 즐겨찾기한 노드와 주고받는 패킷은 Router Late처럼, 그 외의 패킷은 Client처럼 중계합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Węzeł na dachu lub strychu, który przekazuje pakiety od i do ulubionych węzłów jak Router Late, a pozostałe jak Client."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nó em telhado ou sótão que retransmite como Router Late os pacotes vindos de nós favoritos ou destinados a eles, e como Client todos os outros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Нода на крыше или чердаке, которая ретранслирует пакеты от избранных нод или к ним как Router Late, а все остальные — как Client."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вузол на даху чи горищі, який ретранслює пакети від улюблених вузлів або до них як Router Late, а всі інші — як Client."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "安装在屋顶或阁楼的节点：对来自或发往收藏节点的数据包，按 Router Late 方式转发；对其他所有数据包，按 Client 方式处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "設於屋頂或閣樓的節點：對來自或傳往最愛節點的封包，以Router Late方式轉發；其他封包則以客戶端方式轉發。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設於屋頂或閣樓的節點：對來自或傳往最愛節點的封包，以延遲路由器方式轉發；其他封包則以客戶端方式處理。"
          }
        }
      }
    },
