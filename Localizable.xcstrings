    "meshtastic.Config.DeviceConfig.Role.ROUTER_LATE.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.Role.ROUTER_LATE",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Infrastrukturknoten, der Pakete immer einmal weiterleitet, aber erst nach allen anderen Modi. In der Knotenliste sichtbar. Keine gute Wahl für Knoten auf Dächern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Infrastructure node that always rebroadcasts packets once but only after all other modes. Visible in Nodes list. Not a good choice for rooftop nodes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nodo de infraestructura que siempre retransmite los paquetes una vez, pero solo después de todos los demás modos. Visible en la lista de nodos. No es una buena opción para nodos en tejados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nœud d’infrastructure qui rediffuse toujours les paquets une fois, mais seulement après tous les autres modes. Visible dans la liste des nœuds. Peu adapté aux nœuds installés sur un toit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nodo infrastrutturale che ritrasmette sempre i pacchetti una volta, ma solo dopo tutte le altre modalità. Visibile nella lista dei nodi. Non adatto ai nodi sui tetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "パケットを必ず1回再ブロードキャストしますが、ほかのすべてのモードの後に行うインフラストラクチャノードです。ノードリストに表示されます。屋上のノードには適していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "패킷을 항상 한 번 중계하되 다른 모든 모드 이후에만 중계하는 인프라 노드입니다. 노드 목록에 표시됩니다. 옥상 노드에는 적합하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Węzeł infrastrukturalny, który zawsze raz przekazuje pakiety, ale dopiero po wszystkich innych trybach. Widoczny na liście węzłów. Nie najlepszy wybór dla węzłów na dachu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nó de infraestrutura que sempre retransmite os pacotes uma vez, mas só depois de todos os outros modos. Visível na lista de nós. Não é uma boa escolha para nós em telhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Инфраструктурная нода, которая всегда ретранслирует пакеты один раз, но только после всех остальных режимов. Видна в списке нод. Не лучший выбор для нод на крышах."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Інфраструктурний вузол, який завжди ретранслює пакети один раз, але лише після всіх інших режимів. Видимий у списку вузлів. Не найкращий вибір для вузлів на дахах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "始终转发数据包一次、但排在所有其他模式之后的基础设施节点。在节点列表中可见。不适合屋顶节点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "一律會轉發封包一次，但排在所有其他模式之後的基礎設施節點。會顯示在節點列表中。不適合屋頂節點。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "總是會轉發封包一次、但排在所有其他模式之後的基礎設施節點。會顯示在節點列表中。不適合屋頂節點。"
          }
        }
      }
    },
