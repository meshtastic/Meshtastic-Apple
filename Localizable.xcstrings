        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашу позицію надіслано із запитом відповіді з їхньою позицією. Ви отримаєте сповіщення, коли позицію буде повернуто."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
