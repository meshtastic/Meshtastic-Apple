        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Полоса пропускания пресета %@ не соответствует требованиям США. Рекомендуются пресеты Turbo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Смуга пропускання %@ не відповідає вимогам США. Рекомендуються пресети Turbo."
