    "Please do not leave this screen until the update is complete. You can safely play Chirpy Hop while waiting!" : {
      "comment" : "Notice displayed during OTA firmware update",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bitte verlasse diesen Bildschirm nicht, bis das Update abgeschlossen ist. Während du wartest, kannst du bedenkenlos Chirpy Hop spielen!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, no abandone esta pantalla hasta que la actualización se complete. ¡Puede jugar a Chirpy Hop mientras espera!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Veuillez ne pas quitter cet écran avant la fin de la mise à jour. En attendant, vous pouvez jouer à Chirpy Hop sans risque !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non uscire da questa schermata finché l’aggiornamento non è completato. Nell’attesa puoi giocare tranquillamente a Chirpy Hop!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "アップデートが完了するまで、この画面から移動しないでください。待っている間はChirpy Hopを安心してプレイできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "업데이트가 완료될 때까지 이 화면을 벗어나지 마십시오. 기다리는 동안 Chirpy Hop을 안심하고 플레이할 수 있습니다!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie opuszczaj tego ekranu, dopóki aktualizacja się nie zakończy. W międzyczasie możesz spokojnie zagrać w Chirpy Hop!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não saia desta tela até a atualização terminar. Enquanto espera, você pode jogar Chirpy Hop sem problemas!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не покидайте этот экран, пока обновление не завершится. А пока можно спокойно сыграть в Chirpy Hop!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не залишайте цей екран, доки оновлення не завершиться. Поки чекаєте, можна спокійно зіграти в Chirpy Hop!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "更新完成前请勿离开此屏幕。等待期间，您可以放心玩 Chirpy Hop！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "更新完成前請勿離開此畫面。等待期間，您可以放心玩Chirpy跳躍！"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請勿在更新完成前離開此畫面。您可以在等待時安全地玩 Chirpy 跳躍！"
          }
        }
      }
    },
