          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Affiche les cartes enregistrées sur les zones couvertes. Elles apparaissent aussi automatiquement lorsque iOS n’a pas d’accès au réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
