    "Shaded terrain relief over areas with downloaded terrain. Standard and offline maps only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schattiertes Geländerelief über Bereichen mit heruntergeladenem Gelände. Nur Standard- und Offlinekarten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relieve sombreado sobre áreas con terreno descargado. Solo mapas estándar y sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ombrage du relief sur les zones dont le relief est téléchargé. Cartes standard et hors ligne uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rilievo ombreggiato sulle aree con terreno scaricato. Solo mappe standard e offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "地形をダウンロード済みの領域に陰影起伏を表示します。標準マップとオフラインマップのみ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "지형을 다운로드한 지역 위에 음영 기복을 표시합니다. 표준 지도와 오프라인 지도에서만 사용할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cieniowana rzeźba terenu na obszarach z pobranym terenem. Tylko mapa standardowa i offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Relevo sombreado sobre áreas com terreno baixado. Somente mapas padrão e off-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Отмывка рельефа поверх областей с загруженным рельефом. Только для стандартных и офлайн-карт."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Відмивання рельєфу над областями із завантаженим рельєфом. Лише стандартна й офлайн-мапа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在已下载地形的区域显示地形晕渲。仅适用于标准地图和离线地图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在已下載地形的區域顯示地形陰影起伏。僅適用於標準地圖和離線地圖。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已下載地形的區域上顯示陰影地形浮雕。僅限標準和離線地圖。"
          }
        }
      }
    },
