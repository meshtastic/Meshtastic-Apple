    "Enable neighbor info broadcasting. Periodically sends information about directly-heard neighbors to help visualize mesh topology." : {
      "comment" : "A description of the neighbor info broadcasting feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aktiviere das Senden von Nachbarinformationen. Sendet regelmäßig Informationen über direkt empfangene Nachbarn, um die Mesh-Topologie sichtbar zu machen."
          }
        },
        "es" : {
          "stringUnit" : {
