    "meshtastic.ModuleConfig.ExternalNotificationConfig.use_i2s_as_buzzer.description" : {
      "comment" : "description of meshtastic.ModuleConfig.ExternalNotificationConfig.use_i2s_as_buzzer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverer enheder med native I2S-lydudgang til at bruge RTTTL over højttaler som en buzzer. T-Watch S3 og T-Deck har for eksempel denne kapabilitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt Geräten mit nativer I2S-Audioausgabe, RTTTL über Lautsprecher wie eine Glocke zu verwenden. Zum Beispiel haben T-Watch S3 und T-Deck diese Funktion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enables devices with native I2S audio output to use the RTTTL over speaker like a buzzer. T-Watch S3 and T-Deck for example have this capability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que los dispositivos con salida de audio I2S nativa utilicen el RTTTL a través del altavoz como un timbre. T-Watch S3 y T-Deck, por ejemplo, tienen esta capacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet aux appareils dotés d'une sortie audio I2S native d'utiliser RTTTL sur un haut-parleur comme un clignotant. Par exemple, les T-Watch S3 et T-Deck ont cette fonctionnalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente ai dispositivi con uscita audio I2S nativa di utilizzare l'RTTTL tramite altoparlante come un cicalino. T-Watch S3 e T-Deck, ad esempio, dispongono di questa funzionalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネイティブI2Sオーディオ出力を持つデバイスで、ブザーのようにスピーカー経由でRTTTLを使用できるようにします。例えば、T-Watch S3やT-Deckにはこの機能があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 I2S 오디오 출력을 지원하는 장치에서 스피커를 버저처럼 사용하여 RTTTL을 재생할 수 있도록 합니다. 예를 들어 T-Watch S3와 T-Deck은 이 기능을 지원합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pozwala urządzeniom z natywnym wyjściem audio I2S odtwarzać RTTTL przez głośnik jak buzzer. Mają to np. T-Watch S3 i T-Deck."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que dispositivos com saída de áudio I2S nativa usem RTTTL como um zumbido no alto-falante. Exemplos como T-Watch S3 e T-Deck possuem essa capacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет устройствам с нативным аудиовыходом I2S использовать RTTTL через динамик как зуммер. Например, T-Watch S3 и T-Deck имеют эту возможность."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омогућава уређајима са изворним I2S аудио излазом да користе РТТТЛ преко звучника као звучник. Т-Ватцх СКСНУМКС и Т-Децк на пример имају ову могућност."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє пристроям із нативним I2S-аудіовиходом використовувати RTTTL через динамік як зумер. Наприклад, T-Watch S3 і T-Deck мають таку можливість."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使具有本地 I2S 音频输出的设备能够通过扬声器使用 RTTTL，就像使用蜂鸣器一样。例如，T-Watch S3 和 T-Deck 就具有这种功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "支持具有內建I2S音頻輸出功能的設備使用RTTTL以像蜂鳴器一樣在揚聲器上發出聲音。例如，T-Watch S3和T-Deck具有此功能。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用具備原生 I2S 音訊輸出的裝置，透過喇叭以類似蜂鳴器的方式播放 RTTTL。以 T-Watch S3 和 T-Deck 為例，它們就具備此功能。"
          }
        }
      }
    },
