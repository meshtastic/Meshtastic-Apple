    "Applies event highlight colors across the app and available fonts inside this sheet. Standard navigation backgrounds remain unchanged." : {
      "comment" : "A description of the effect of toggling the event theme.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wendet die Event-Hervorhebungsfarben in der ganzen App und die verfügbaren Schriften in diesem Fenster an. Die Standard-Navigationshintergründe bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica colores de resaltado de eventos en toda la aplicación y las fuentes disponibles en esta hoja. Los fondos de navegación estándar permanecen sin cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Applique les couleurs de mise en évidence de l’événement dans toute l’app et les polices disponibles dans cette fenêtre. Les arrière-plans de navigation standard restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Applica i colori di evidenziazione dell’evento in tutta l’app e i font disponibili in questo pannello. Gli sfondi di navigazione standard restano invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "イベントのハイライトカラーをアプリ全体に、利用可能なフォントをこのシート内に適用します。標準のナビゲーション背景は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "앱 전체에 이벤트 강조 색상을 적용하고 이 시트에서 사용 가능한 서체를 적용합니다. 표준 탐색 배경은 변경되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stosuje kolory wyróżnień wydarzenia w całej aplikacji oraz dostępne czcionki w tym arkuszu. Standardowe tła nawigacji pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplica as cores de destaque do evento em todo o app e as fontes disponíveis nesta janela. Os fundos de navegação padrão não mudam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Применяет цвета выделения события во всем приложении и доступные шрифты в этом окне. Стандартные фоны навигации остаются без изменений."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Застосовує кольори виділення події в усьому застосунку та доступні шрифти в цьому вікні. Стандартні фони навігації залишаються без змін."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在整个 App 中应用活动强调颜色，并在此面板中应用可用字体。标准导航背景保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在整個應用程式中套用活動強調顏色，並在此表單中套用可用的字體。標準導覽背景保持不變。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在整個應用程式中套用活動醒目顏色，以及此工作表中可用的字型。標準導覽背景保持不變。"
          }
        }
      }
    },
