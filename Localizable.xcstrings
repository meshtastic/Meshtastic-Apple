          }
        }
      }
    },
    "This channel is no longer on your radio. Its messages are kept here, but you can't send to it. Add the channel again to pick up the conversation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dieser Kanal ist nicht mehr auf deinem Funkgerät. Seine Nachrichten bleiben hier erhalten, aber du kannst nicht an ihn senden. Füge den Kanal erneut hinzu, um die Unterhaltung fortzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este canal ya no está en tu radio. Sus mensajes se conservan aquí, pero no puedes enviar mensajes a él. Vuelve a añadir el canal para retomar la conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ce canal n’est plus sur votre radio. Ses messages sont conservés ici, mais vous ne pouvez pas y envoyer de messages. Ajoutez de nouveau le canal pour reprendre la conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questo canale non è più presente sulla radio. I suoi messaggi restano qui, ma non puoi inviare messaggi al canale. Aggiungi di nuovo il canale per riprendere la conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このチャンネルは無線機上にもうありません。メッセージはここに保持されますが、このチャンネルには送信できません。会話を再開するには、チャンネルをもう一度追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 채널은 더 이상 무선 장치에 없습니다. 메시지는 여기에 보관되지만 이 채널로 보낼 수는 없습니다. 대화를 이어가려면 채널을 다시 추가하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego kanału nie ma już w radiu. Jego wiadomości zostają tutaj, ale nie możesz na niego wysyłać. Dodaj kanał ponownie, aby kontynuować rozmowę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Este canal não está mais no seu rádio. As mensagens dele continuam aqui, mas você não pode enviar mensagens para ele. Adicione o canal de novo para retomar a conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Этого канала больше нет на радиостанции. Его сообщения сохранены здесь, но отправлять в него нельзя. Добавьте канал снова, чтобы продолжить разговор."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Цього каналу більше немає на вашій радіостанції. Його повідомлення збережено тут, але надсилати в нього не можна. Додайте канал знову, щоб продовжити розмову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此频道已不在您的电台上。其消息仍保留在此处，但您无法向其发送消息。重新添加此频道即可继续对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "此頻道已不在您的無線電上。其訊息仍保留在此，但您無法傳送訊息到此頻道。重新新增此頻道即可繼續對話。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此頻道已不在您的無線電上。訊息仍保留在這裡，但您無法在此頻道傳送訊息。重新新增此頻道即可繼續對話。"
          }
        }
      }
    },
