    "meshtastic.ModuleConfig.NeighborInfoConfig.transmit_over_lora.description" : {
      "comment" : "description of meshtastic.ModuleConfig.NeighborInfoConfig.transmit_over_lora",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ob Nachbarinformationen zusätzlich zu MQTT und der verbundenen App auch über LoRa gesendet werden. Nicht verfügbar auf Kanälen mit Standardschlüssel und Standardnamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Whether to transmit neighbor info over LoRa in addition to MQTT and the connected app. Not available on channels with default key and name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indica si la información de vecinos se transmite por LoRa además de por MQTT y la app conectada. No disponible en canales con la clave y el nombre predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indique s’il faut transmettre les informations sur les voisins via LoRa en plus de MQTT et de l’app connectée. Non disponible sur les canaux utilisant la clé et le nom par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indica se trasmettere le informazioni sui vicini tramite LoRa, oltre che tramite MQTT e l’app connessa. Non disponibile sui canali con chiave e nome predefiniti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "MQTTと接続中のアプリに加えて、LoRa経由でも近隣ノード情報を送信するかどうか。デフォルトのキーと名前を使用するチャンネルでは利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MQTT 및 PhoneAPI와 함께 LoRa를 통해 이웃 정보를 전송할지 여부입니다. 기본 키와 이름을 사용하는 채널에서는 사용할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Czy wysyłać Info o sąsiadach przez LoRa, oprócz MQTT i połączonej aplikacji. Niedostępne na kanałach z domyślnym kluczem i nazwą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Define se as informações de vizinhos também são transmitidas via LoRa, além de MQTT e do app conectado. Não disponível em canais com chave e nome padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Передавать ли информацию о соседях через LoRa в дополнение к MQTT и подключенному приложению. Недоступно на каналах с ключом и именем по умолчанию."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чи передавати інформацію про сусідів через LoRa на додачу до MQTT і PhoneAPI. Недоступно на каналах із типовими ключем і назвою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "是否在 MQTT 和已连接的 App 之外，同时通过 LoRa 发送邻居信息。使用默认密钥和名称的频道不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "除了MQTT與已連線的App之外，是否也透過LoRa傳送鄰居資訊。使用預設金鑰與名稱的頻道無法使用此功能。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了 MQTT 與已連線的 App 外，是否也透過 LoRa 傳送鄰居資訊。使用預設金鑰與名稱的頻道無法使用。"
          }
        }
      }
    },
