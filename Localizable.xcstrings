        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Speicher- und Weiterleitungsserver benötigen einen ESP32-Gerät mit PSRAM oder Linux Native."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores de almacenamiento y reenvío requieren un dispositivo ESP32 con PSRAM o Linux Native."
