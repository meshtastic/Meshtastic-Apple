    "Where you are, so the radio uses legal frequencies." : {
      "comment" : "Radio setup intro row",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wo du bist, damit dein Funkgerät erlaubte Frequenzen verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dónde te encuentras, para que la radio use frecuencias legales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’endroit où vous vous trouvez, pour que la radio utilise des fréquences autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dove ti trovi, così la radio usa le frequenze consentite."
          }
        },
        "ja" : {
          "stringUnit" : {
