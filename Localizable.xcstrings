    "Dashed blue line back to the originator. Where both paths use the same leg, the two lines sit side by side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gestrichelte blaue Linie zurück zum Absender. Wo beide Wege denselben Abschnitt nutzen, verlaufen die zwei Linien nebeneinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Línea azul punteada de vuelta al nodo de origen. Donde ambos trayectos comparten el mismo tramo, las dos líneas aparecen una junto a la otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ligne bleue en pointillés vers le nœud d’origine. Là où les deux trajets empruntent le même tronçon, les deux lignes sont côte à côte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Linea blu tratteggiata di ritorno al nodo di origine. Dove entrambi i percorsi usano la stessa tratta, le due linee sono affiancate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "発信元へ戻る青い破線。往路と復路が同じ区間を通る場合は、2本の線が並んで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "발신 노드로 돌아오는 파란색 점선입니다. 두 경로가 같은 구간을 지나는 곳에서는 두 선이 나란히 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niebieska przerywana linia z powrotem do nadawcy. Gdy obie trasy biegną tym samym odcinkiem, linie są obok siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Linha azul tracejada de volta ao nó de origem. Onde os dois caminhos usam o mesmo trecho, as duas linhas ficam lado a lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Синяя пунктирная линия обратно к отправителю. Там, где оба пути проходят по одному участку, две линии идут рядом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Синя пунктирна лінія назад до відправника. Там, де обидва шляхи проходять тим самим відрізком, дві лінії йдуть поруч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "蓝色虚线表示返回发起节点的路径。若去程与回程经过同一路段，两条线会并排显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "藍色虛線表示返回發起節點的路徑。若去程與回程共用同一路段，兩條線會並排顯示。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "藍色虛線表示返回發起節點的路徑。若去程與回程共用同一路段，兩條線會並排顯示。"
          }
        }
      }
    },
