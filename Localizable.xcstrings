    "meshtastic.ClientNotification.NotificationType.DUTY_CYCLE_LIMIT_EXCEEDED.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.DUTY_CYCLE_LIMIT_EXCEEDED",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Duty-Cycle-Grenze ist überschritten. Das Senden wird fortgesetzt, sobald wieder Airtime verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The duty cycle limit is exceeded. Sending resumes once airtime is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se ha superado el límite del ciclo de trabajo. El envío se reanudará cuando haya tiempo de emisión disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La limite du cycle de service est dépassée. L’envoi reprendra dès que du temps d’émission sera disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il limite del ciclo di lavoro è stato superato. L’invio riprenderà non appena il tempo di trasmissione sarà disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "デューティサイクル制限を超えました。エアタイムが利用可能になると送信が再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "듀티 사이클 제한을 초과했습니다. 송신 시간을 사용할 수 있게 되면 전송이 재개됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przekroczono limit duty cycle. Wysyłanie zostanie wznowione, gdy zwolni się czas antenowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O limite do ciclo de trabalho foi excedido. O envio será retomado assim que houver tempo de transmissão disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Превышен лимит рабочего цикла. Отправка возобновится, как только освободится эфирное время."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Перевищено ліміт duty cycle. Надсилання відновиться, щойно з’явиться доступний ефірний час."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "已超出占空比限制。有可用的发射时间后将恢复发送。"
          }
