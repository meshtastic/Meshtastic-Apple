    "meshtastic.Config.PositionConfig.fixed_position.description" : {
      "comment" : "description of meshtastic.Config.PositionConfig.fixed_position",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Statt einer aktuellen GPS-Position werden der zuletzt bekannte Breitengrad, Längengrad und die Höhe im Positionsintervall über das Mesh gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The last known latitude, longitude and altitude are broadcast over the mesh on the position interval, rather than a live GPS fix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Difunde por la malla la última latitud, longitud y altitud conocidas en el intervalo de posición, en lugar de una posición GPS en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les dernières latitude, longitude et altitude connues sont diffusées sur le réseau à chaque intervalle de position, au lieu d’une position GPS en temps réel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al posto di un rilevamento GPS in tempo reale, l’ultima latitudine, longitudine e altitudine note vengono trasmesse sulla mesh a ogni intervallo di posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "リアルタイムのGPS測位の代わりに、最後に確認された緯度、経度、および高度を位置間隔ごとにメッシュ上にブロードキャストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "실시간 GPS 위치 대신 마지막으로 확인된 위도, 경도 및 고도를 위치 간격마다 Mesh를 통해 브로드캐스트합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ostatnia znana szerokość, długość i wysokość są wysyłane do sieci co interwał pozycji zamiast bieżącego odczytu GPS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A última latitude, longitude e altitude conhecidas são transmitidas pela rede mesh no intervalo de posição, em vez de uma posição GPS em tempo real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Вместо текущих данных GPS по сети с интервалом позиции транслируются последние известные широта, долгота и высота."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Замість поточних даних GPS через mesh з інтервалом позиції транслюються останні відомі широта, довгота й висота."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "按位置广播间隔，通过 Mesh 网络广播最后已知的纬度、经度和高度，而非实时 GPS 定位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "依位置廣播間隔，透過網格廣播最後已知的緯度、經度和高度，而非即時GPS定位。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依位置廣播間隔，透過 Mesh 廣播最後已知的緯度、經度和高度，而非即時 GPS 定位。"
          }
        }
      }
    },
