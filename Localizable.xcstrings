    "meshtastic.Config.DeviceConfig.RebroadcastMode.ALL_SKIP_DECODING.description" : {
      "comment" : "description of meshtastic.Config.DeviceConfig.RebroadcastMode.ALL_SKIP_DECODING",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verhält sich wie „Alle“. Das Überspringen der Paketdekodierung galt nur für die Rolle Repeater, die nicht mehr unterstützt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Behaves as All. Skipping packet decoding applied only to the Repeater role, which is no longer supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se comporta como “Todos”. Omitir la decodificación de paquetes solo se aplicaba al rol Repeater, que ya no es compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se comporte comme « Tous ». L’omission du décodage des paquets ne s’appliquait qu’au rôle Repeater, qui n’est plus pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si comporta come “Tutti”. Il salto della decodifica dei pacchetti si applicava solo al ruolo Repeater, che non è più supportato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「全て」と同じ動作になります。パケットのデコードの省略は、サポートが終了したRepeaterの役割にのみ適用されていました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "‘제한 없음’과 동일하게 작동합니다. 패킷 디코딩 건너뛰기는 더 이상 지원되지 않는 Repeater 역할에만 적용되었습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Działa jak Wszystkie. Pomijanie dekodowania pakietów dotyczyło tylko roli Repeater, która nie jest już obsługiwana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Funciona como “Tudo”. Pular a decodificação de pacotes só se aplicava ao papel Repeater, que não é mais compatível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Работает как «Все». Пропуск декодирования пакетов применялся только к роли Repeater, которая больше не поддерживается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Працює як «Усі». Пропуск декодування пакетів застосовувався лише до ролі Repeater, яка більше не підтримується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "与“全部”相同。跳过数据包解码仅适用于 Repeater 角色，而该角色已不再受支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "運作方式與「全部」相同。略過封包解碼僅適用於Repeater角色，而該角色已不再受支援。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行為與「全部」相同。略過封包解碼僅適用於中繼器角色，而該角色已不再支援。"
          }
        }
      }
    },
