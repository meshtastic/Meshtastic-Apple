    "Positions from the same node arriving sooner than this are dropped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Positionen desselben Knotens, die in kürzerem Abstand eintreffen, werden verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las posiciones provenientes del mismo nodo que llegan antes que esta se descartan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les positions d’un même nœud qui arrivent avant cet intervalle sont ignorées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le posizioni dello stesso nodo che arrivano prima di questo intervallo vengono scartate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同じノードからの位置がこの間隔より早く届いた場合は破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "같은 노드에서 이 간격보다 빨리 도착한 위치는 삭제됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pozycje od tego samego węzła, które przychodzą częściej niż co tyle, są odrzucane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Posições do mesmo nó que chegarem antes desse intervalo são descartadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Позиции от одной и той же ноды, поступающие чаще этого интервала, отбрасываются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Позиції з того самого вузла, що надходять частіше за цей інтервал, відкидаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "来自同一节点、到达间隔短于此值的位置将被丢弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "來自同一節點、到達間隔短於此值的位置會被捨棄。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自同一節點且比此時間更早到達的位置會被丟棄。"
          }
        }
      }
    },
    "Positions will be provided by your device GPS, if you select disabled or not present you can set a fixed position." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positioner vil blive angivet af din enheds GPS, hvis du vælger deaktiveret eller ikke til stede, kan du indstille en fast position."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Positionen werden von deinem Gerät GPS bereitgestellt. Wenn du deaktiviert oder nicht vorhanden auswählst, kannst du eine feste Position festlegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las posiciones serán proporcionadas por el GPS de su dispositivo; si selecciona deshabilitado o no presente, puede establecer una posición fija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les positions seront fournies par le GPS de votre appareil, si vous sélectionnez désactivé ou non présent, vous pouvez définir une position fixe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le posizioni saranno fornite dal GPS del dispositivo; se si seleziona disabilitato o non presente, è possibile impostare una posizione fissa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報はデバイスのGPSによって提供されます。無効または存在しないを選択した場合は、固定位置を設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 정보는 기기의 GPS에서 제공됩니다. '사용 안 함' 또는 '없음'을 선택하면 고정 위치를 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As posições serão fornecidas pelo GPS do seu dispositivo, se você selecionar desativado ou não presente, você pode definir uma posição fixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позиции будут предоставлены GPS вашего устройства. Если вы выберете отключено или отсутствует, вы можете установить фиксированную позицию."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позиције ће бити обезбеђене путем GPS-а вашег уређаја. Ако одаберете опцију „онемогућено“ или „није присутно“, можете подесити фиксну позицију."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позиції надаватиме GPS вашого пристрою. Якщо вибрати вимкнено або відсутній, можна встановити фіксовану позицію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置将由设备 GPS 提供，如果选择禁用或不存在，则可以设置固定位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "位置將由您的設備GPS提供，如果您選擇禁用或未存在，您可以設定固定位置。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置的 GPS 會提供位置資訊，若選擇「已停用」或「無此功能」，則可手動設定固定位置。"
          }
        }
      }
    },
