        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El destino ha recibido la solicitud, pero ninguna app ni módulo ha respondido. Inténtalo de nuevo cuando el destinatario esté accesible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La destination a reçu la demande, mais aucune app ni aucun module n’a répondu. Réessayez lorsque le destinataire sera joignable."
