    "meshtastic.Config.SecurityConfig.admin_key.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffentliche Schlüssel (bis zu drei), die berechtigt sind, Admin-Nachrichten an diesen Knoten zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
