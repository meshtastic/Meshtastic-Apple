    "meshtastic.Config.SecurityConfig.PacketSignaturePolicy.PACKET_SIGNATURE_POLICY_BALANCED.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Authentifizierte Pakete werden bevorzugt, unsignierter Datenverkehr von Knoten, die nicht bekanntermaßen signieren, wird aber weiterhin akzeptiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefer authenticated packets, but still accept unsigned traffic from nodes not known to sign."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prefiere los paquetes autenticados, pero sigue aceptando tráfico sin firmar de nodos que no se sabe si firman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Privilégie les paquets authentifiés, mais accepte toujours le trafic non signé des nœuds qui ne sont pas connus pour signer leurs paquets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Preferisce i pacchetti autenticati, ma accetta comunque il traffico non firmato dai nodi che non risultano firmare i pacchetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "認証済みのパケットを優先しますが、署名することが分かっていないノードからの署名のないトラフィックも引き続き受け入れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "인증된 패킷을 우선하지만, 서명하는 것으로 알려지지 않은 노드의 서명되지 않은 트래픽은 계속 허용합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preferuj uwierzytelnione pakiety, ale nadal akceptuj niepodpisany ruch od węzłów, o których nie wiadomo, że podpisują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prefere pacotes autenticados, mas ainda aceita tráfego não assinado de nós que não se sabe se assinam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Предпочитать аутентифицированные пакеты, но по-прежнему принимать неподписанный трафик от нод, о которых неизвестно, подписывают ли они пакеты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Надає перевагу автентифікованим пакетам, але й надалі приймає непідписаний трафік від вузлів, про які не відомо, що вони підписують пакети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "优先使用已验证的数据包，但仍接受尚未确认会签名的节点发来的未签名流量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "優先採用已驗證的封包，但仍接受未知是否會簽署的節點所傳送的未簽署流量。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先已簽署封包但仍接受未簽署"
          }
        }
      }
    },
