    "Place your device in DFU mode and connect it via USB. It appears as a USB drive." : {
      "comment" : "A description of how to connect a device to the bootloader.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
