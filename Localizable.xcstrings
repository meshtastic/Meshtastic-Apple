    "Long Fast's bandwidth is not compliant in the US. Long Turbo is the recommended preset." : {
      "comment" : "A warning message for the Long Fast modem preset.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Bandbreite von Long Fast ist in den USA nicht zulässig. Long Turbo ist die empfohlene Voreinstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ancho de banda de Long Fast no cumple con las normativas de EE.UU. Se recomienda el ajuste preestablecido Long Turbo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La bande passante de Long Fast n’est pas conforme aux États-Unis. Long Turbo est le préréglage recommandé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La larghezza di banda di Long Fast non è conforme alle normative degli Stati Uniti. Si consiglia la preimpostazione Long Turbo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Long Fastの帯域幅は米国の規制に準拠していません。Long Turboプリセットをおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Long Fast의 대역폭은 미국 규정에 맞지 않습니다. Long Turbo 프리셋을 권장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
