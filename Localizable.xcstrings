    "meshtastic.ClientNotification.NotificationType.KEY_VERIFICATION_FINAL_INCOMING.description" : {
      "comment" : "description of meshtastic.ClientNotification.NotificationType.KEY_VERIFICATION_FINAL_INCOMING",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bestätige, dass der Verifizierungscode mit dem entfernten Knoten übereinstimmt, um die eingehende Schlüsselverifizierung abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Confirm that the verification code matches the remote node to finish the incoming key verification."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Confirma que el código de verificación coincide con el del nodo remoto para completar la verificación de clave entrante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Confirmez que le code de vérification correspond à celui du nœud distant pour terminer la vérification de clé entrante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Conferma che il codice di verifica corrisponda a quello del nodo remoto per completare la verifica della chiave in entrata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "受信した鍵の検証を完了するには、検証コードがリモートノードと一致していることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "수신 키 검증을 완료하려면 검증 코드가 원격 노드와 일치하는지 확인하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potwierdź, że kod weryfikacyjny zgadza się ze zdalnym węzłem, aby zakończyć przychodzącą weryfikację klucza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Confirme que o código de verificação corresponde ao do nó remoto para concluir a verificação de chave recebida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Подтвердите, что код проверки совпадает с кодом на удаленной ноде, чтобы завершить входящую проверку ключа."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Підтвердьте, що код перевірки збігається з кодом на віддаленому вузлі, щоб завершити вхідну перевірку ключа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请确认验证码与远程节点一致，以完成传入的密钥验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請確認驗證碼與遠端節點相符，以完成傳入的金鑰驗證。"
          }
        },
        "zh-Hant-TW" : {
