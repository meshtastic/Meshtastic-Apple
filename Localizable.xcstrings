    "Lower values usually mean a quieter receiver environment." : {
      "comment" : "A description of the meaning of a lower noise floor value.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Niedrigere Werte bedeuten meist eine ruhigere Empfangsumgebung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores más bajos suelen indicar un entorno con menos ruido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Des valeurs plus basses indiquent généralement un environnement de réception moins bruité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Valori più bassi indicano di solito un ambiente di ricezione meno rumoroso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "値が低いほど、通常は受信環境のノイズが少ないことを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값이 낮을수록 일반적으로 수신 환경의 잡음이 적음을 의미합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niższe wartości zwykle oznaczają mniej zakłóceń wokół odbiornika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Valores mais baixos geralmente indicam menos ruído em volta do receptor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Более низкие значения обычно означают меньше помех вокруг приемника."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нижчі значення зазвичай означають тихіше середовище приймача."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "数值越低，通常表示接收环境的噪声越小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "數值越低，通常表示接收環境的雜訊越少。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "數值較低通常表示接收環境較安靜。"
          }
        }
      }
    },
